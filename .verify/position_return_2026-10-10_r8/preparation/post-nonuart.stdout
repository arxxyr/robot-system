{"schema": "MAINTENANCE_NON_UART_CURRENT_FACTS_20261010_R1", "read_only": true, "status": "PASS_NON_UART_CURRENT_FACTS", "started_ns": 1791623451814965311, "started_monotonic_ns": 3376701275713478, "commands": [{"argv": ["git", "-C", "/home/loosqk/robot-checks/h2-exit-observation-20261009-r1/source", "rev-parse", "HEAD"], "started_ns": 1791623451824901859, "started_monotonic_ns": 3376701285648426, "pid": 624670, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623451827529238, "elapsed_ns": 2624083, "child_end_class": "EXIT_STATUS", "stdout": "894084738d95a7239611c2b8fbecfe081d3a7fc9\n", "stderr": "", "stdout_sha256": "296260f3243fff4a5bdb3bf054d0eea35d713a2d4daf22d3f59629d80a64d0d6", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 41, "stderr_bytes": 0}, {"argv": ["git", "-C", "/home/loosqk/robot-checks/h2-exit-observation-20261009-r1/source", "status", "--porcelain=v1", "--untracked-files=all"], "started_ns": 1791623451827690650, "started_monotonic_ns": 3376701288437121, "pid": 624671, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623451839156155, "elapsed_ns": 11462369, "child_end_class": "EXIT_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["git", "-C", "/home/loosqk/robot-checks/h2-exit-observation-20261009-r1/source", "show", "HEAD:scripts/run_post_e_h2.py"], "started_ns": 1791623451839573060, "started_monotonic_ns": 3376701300319339, "pid": 624674, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623451842844868, "elapsed_ns": 3270144, "child_end_class": "EXIT_STATUS", "stdout": "#!/usr/bin/env -S uv run --no-project python\n\"\"\"双臂 H2 监督驱动；默认只输出计划，真实执行须本次明确事实与完整清单。\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport errno\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport pwd\nimport re\nimport resource\nimport shutil\nimport signal\nimport stat\nimport subprocess\nimport sys\nimport time\nimport tomllib\nimport traceback\n\nfrom post_e_h2_report import arm_profile, require, strict_json, verify_report\n\nUNITS = tuple(f\"xlerobot-{role}-{side}{'-arm' if role == 's0' else ''}.service\"\n              for role in (\"gateway\", \"s1\", \"s0\") for side in (\"left\", \"right\"))\n# 旧只读 helper 的左侧默认别名；真实运行只用显式 profile。\nDEVICE = arm_profile().device\nTRUST = arm_profile().trust\nCONFIG = arm_profile().config\n\n\ndef file_hash(path):\n    path = Path(path)\n    metadata = path.lstat()\n    require(stat.S_ISREG(metadata.st_mode) and metadata.st_nlink == 1, f\"非独立普通文件：{path}\")\n    with path.open(\"rb\") as source:\n        return hashlib.file_digest(source, \"sha256\").hexdigest()\n\n\ndef pinned_json(reference):\n    path = Path(reference[\"path\"])\n    require(path.is_absolute() and path == path.resolve(), \"清单路径必须绝对且无符号链接\")\n    require(file_hash(path) == reference[\"sha256\"], f\"清单 SHA 改变：{path}\")\n    return strict_json(path.read_text())\n\n\ndef clean_environment(original):\n    blocked = {\"NOTIFY_SOCKET\", \"INVOCATION_ID\", \"WATCHDOG_USEC\", \"WATCHDOG_PID\",\n               \"ROBOT_ID\", \"ROBOT_GATEWAY_ADDR\", \"ROBOT_TOKEN\"}\n    result = {key: value for key, value in original.items()\n              if not key.startswith(\"ROBOT_TEST_\") and key not in blocked}\n    result[\"RUST_LOG\"] = \"info\"\n    return result\n\n\ndef tool_command(bin_dir, output, side=\"left\"):\n    profile = arm_profile(side)\n    return [\"taskset\", \"-c\", \"0-3\", str(bin_dir / \"comm_fault_e2e\"), \"--phase\", \"orin-sla\",\n            \"--bin-dir\", str(bin_dir), \"--evidence-dir\", str(output), \"--config\", str(profile.config),\n            \"--hardware-id\", profile.hardware_id, \"--ack-supervised-hardware\"]\n\n\n# 同一份固定只读代码供普通进程读取和受限 sudo 探针使用；默认导入仅定义函数。\n# stdin 只接受已采集的 PID 身份，不能选择路径、命令或写操作。\nPROC_PROBE_CODE = r'''\nimport json\nimport os\nimport sys\n\ndef _read_at(directory, name, limit):\n    descriptor = os.open(name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=directory)\n    try:\n        data = bytearray()\n        while len(data) <= limit:\n            part = os.read(descriptor, min(8192, limit + 1 - len(data)))\n            if not part:\n                return bytes(data)\n            data.extend(part)\n        raise ValueError(\"proc字段超过读取上限\")\n    finally:\n        os.close(descriptor)\n\ndef _stat_at(directory, pid):\n    raw = _read_at(directory, \"stat\", 8192).decode()\n    opening, closing = raw.find(\"(\"), raw.rfind(\")\")\n    if opening < 1 or closing <= opening or int(raw[:opening].strip()) != pid:\n        raise ValueError(\"proc stat PID格式错误\")\n    fields = raw[closing + 2:].split()\n    start = int(fields[19])\n    if start < 0:\n        raise ValueError(\"proc start_ticks不能为负\")\n    return {\"pid\": pid, \"start_ticks\": start, \"pgid\": int(fields[2]), \"state\": fields[0]}\n\ndef _uids_at(directory):\n    rows = [line.split()[1:] for line in _read_at(directory, \"status\", 65536).decode().splitlines()\n            if line.startswith(\"Uid:\")]\n    if len(rows) != 1 or len(rows[0]) != 4:\n        raise ValueError(\"proc Uid字段不完整\")\n    values = [int(value) for value in rows[0]]\n    if any(value < 0 for value in values):\n        raise ValueError(\"proc Uid无效\")\n    return values\n\ndef _boot(root):\n    with open(root + \"/sys/kernel/random/boot_id\", encoding=\"ascii\") as stream:\n        value = stream.read(128).strip()\n    if len(value) != 36 or any(c not in \"0123456789abcdef-\" for c in value):\n        raise ValueError(\"proc boot_id格式错误\")\n    return value\n\ndef _stable(left, right):\n    return all(left[key] == right[key] for key in (\"pid\", \"start_ticks\", \"boot_id\", \"pgid\", \"uids\"))\n\ndef _proc_probe(pid, expected=None, details=True, root=\"/proc\"):\n    result = {\"pid\": pid}\n    directory = None\n    try:\n        directory = os.open(root + \"/\" + str(pid), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)\n        before = _stat_at(directory, pid)\n        before.update(boot_id=_boot(root), uids=_uids_at(directory))\n        result[\"before\"] = before\n        if expected is not None and not _stable(before, expected):\n            return dict(result, status=\"replaced\")\n        identity = dict(before)\n        if details:\n            identity[\"argv\"] = _read_at(directory, \"cmdline\", 65536).rstrip(b\"\\0\").decode().split(\"\\0\")\n            identity[\"exe\"] = None if before[\"state\"] == \"Z\" else os.readlink(\"exe\", dir_fd=directory)\n            identity[\"zombie\"] = before[\"state\"] == \"Z\"\n        after = _stat_at(directory, pid)\n        after.update(boot_id=_boot(root), uids=_uids_at(directory))\n        result[\"after\"] = after\n        if not _stable(before, after):\n            return dict(result, status=\"replaced\")\n        return dict(result, status=\"observed\", identity=identity)\n    except FileNotFoundError as error:\n        result.update(error_errno=error.errno, error_filename=error.filename)\n        # exe缺失不等于PID退出；只在同一dirfd的stat也消失时报告vanished。\n        if directory is not None:\n            try:\n                result[\"remaining_stat\"] = _stat_at(directory, pid)\n            except FileNotFoundError:\n                return dict(result, status=\"vanished\", error=repr(error))\n            except Exception as recheck_error:\n                return dict(result, status=\"unreadable\", error=repr(recheck_error))\n            return dict(result, status=\"unreadable\", error=repr(error))\n        return dict(result, status=\"vanished\", error=repr(error))\n    except PermissionError as error:\n        return dict(result, status=\"permission\", error=repr(error))\n    except (OSError, ValueError, KeyError, IndexError, UnicodeError) as error:\n        return dict(result, status=\"unreadable\", error=repr(error))\n    finally:\n        if directory is not None:\n            os.close(directory)\n\ndef _probe_main():\n    text = sys.stdin.read(131073)\n    if len(text) > 131072:\n        raise ValueError(\"PID批次输入过大\")\n    request = json.loads(text)\n    if set(request) != {\"schema\", \"candidates\"} or request[\"schema\"] != \"P7_PROC_PROBE_V1\":\n        raise ValueError(\"PID探针请求格式错误\")\n    candidates = request[\"candidates\"]\n    if not isinstance(candidates, list) or not 1 <= len(candidates) <= 256:\n        raise ValueError(\"PID批次超限\")\n    pids = set()\n    for expected in candidates:\n        if set(expected) != {\"pid\", \"start_ticks\", \"boot_id\", \"pgid\", \"state\", \"uids\"}:\n            raise ValueError(\"PID身份字段错误\")\n        pid = expected[\"pid\"]\n        if type(pid) is not int or pid <= 0 or pid in pids:\n            raise ValueError(\"PID无效或重复\")\n        if type(expected[\"start_ticks\"]) is not int or expected[\"start_ticks\"] < 0:\n            raise ValueError(\"start_ticks无效\")\n        if type(expected[\"pgid\"]) is not int or expected[\"pgid\"] < 0:\n            raise ValueError(\"PGID无效\")\n        if not isinstance(expected[\"uids\"], list) or len(expected[\"uids\"]) != 4 or any(type(u) is not int or u < 0 for u in expected[\"uids\"]):\n            raise ValueError(\"Uid无效\")\n        if not isinstance(expected[\"state\"], str) or len(expected[\"state\"]) != 1 or not isinstance(expected[\"boot_id\"], str):\n            raise ValueError(\"PID状态/boot错误\")\n        pids.add(pid)\n    print(json.dumps({\"schema\": \"P7_PROC_PROBE_V1\", \"reader_euid\": os.geteuid(), \"boot_id\": _boot(\"/proc\"),\n                      \"rows\": [_proc_probe(row[\"pid\"], row) for row in candidates]}, ensure_ascii=False))\n\nif __name__ == \"__main__\":\n    _probe_main()\n'''\n_PROC_READER = {\"__name__\": \"p7_fixed_proc_reader\"}\nexec(PROC_PROBE_CODE, _PROC_READER)\n\n\ndef read_process(pid, expected=None, details=True, proc=Path(\"/proc\")):\n    return _PROC_READER[\"_proc_probe\"](pid, expected, details, str(proc))\n\n\ndef process_identity(pid, proc=Path(\"/proc\")):\n    row = read_process(pid, proc=proc)\n    require(row[\"status\"] == \"observed\", f\"进程身份不稳定或不可读：{row}\")\n    return row[\"identity\"]\n\n\ndef privileged_process_probe(candidates):\n    \"\"\"最多一次有界只读PID批次；不导入项目代码，不继承Python加载环境。\"\"\"\n    argv = [\"sudo\", \"-n\", \"/usr/bin/python3\", \"-I\", \"-S\", \"-c\", PROC_PROBE_CODE]\n    request = {\"schema\": \"P7_PROC_PROBE_V1\", \"candidates\": candidates}\n    row = {\"argv_prefix\": argv[:6], \"code_sha256\": hashlib.sha256(PROC_PROBE_CODE.encode()).hexdigest(),\n           \"request\": request, \"started_ns\": time.time_ns()}\n    try:\n        completed = subprocess.run(argv, input=json.dumps(request), capture_output=True, text=True,\n                                   timeout=10, check=False, env={\"PATH\": \"/usr/sbin:/usr/bin:/sbin:/bin\", \"LC_ALL\": \"C\"})\n        row.update(exit_code=completed.returncode, stdout=completed.stdout, stderr=completed.stderr)\n        require(completed.returncode == 0 and not completed.stderr.strip(), \"只读PID探针未成功\")\n        row[\"response\"] = strict_json(completed.stdout)\n    except (OSError, ValueError, subprocess.SubprocessError) as error:\n        row[\"error\"] = repr(error)\n    row[\"finished_ns\"] = time.time_ns()\n    return row\n\n\ndef process_snapshot(pgid, output, binaries, proc=Path(\"/proc\"), *, probe_runner=None, reader=None):\n    \"\"\"普通身份先读；只为已绑定身份的EACCES候选提权核实，不忽略未知。\"\"\"\n    related, unreadable, vanished, denied, candidates = [], [], [], [], []\n    read = reader or read_process\n    binary_names = {str(path) for path in binaries}\n\n    def classify(row):\n        identity = row[\"identity\"]\n        arguments = identity[\"argv\"]\n        if (identity[\"pgid\"] == pgid or str(output) in arguments or identity[\"exe\"] in binary_names\n                or any(argument in binary_names for argument in arguments)):\n            related.append(identity)\n\n    for path in proc.iterdir():\n        if not path.name.isdigit() or int(path.name) == os.getpid():\n            continue\n        pid = int(path.name)\n        basic = read(pid, details=False, proc=proc)\n        if basic[\"status\"] == \"vanished\":\n            vanished.append(basic)\n            continue\n        if basic[\"status\"] != \"observed\":\n            unreadable.append(basic)\n            continue\n        identity = basic[\"identity\"]\n        if identity[\"pgid\"] != pgid and os.getuid() not in identity[\"uids\"]:\n            continue\n        row = read(pid, expected=identity, proc=proc)\n        if row[\"status\"] == \"observed\":\n            classify(row)\n        elif row[\"status\"] == \"permission\":\n            denied.append(row)\n            candidates.append(identity)\n        elif row[\"status\"] == \"vanished\":\n            vanished.append(row)\n        else:\n            unreadable.append(row)\n    probe = None\n    if candidates:\n        try:\n            require(len(candidates) <= 256, \"拒读PID数量超过有限批次\")\n            # 临时proc夹具不会意外访问宿主机sudo；测试必须显式提供后端。\n            require(proc == Path(\"/proc\") or probe_runner is not None, \"非真实proc需要显式只读探针夹具\")\n            probe = (probe_runner or privileged_process_probe)(candidates)\n            require(isinstance(probe, dict) and not probe.get(\"error\") and probe.get(\"exit_code\") == 0, \"只读PID探针失败\")\n            response = probe[\"response\"]\n            require(isinstance(response, dict) and response[\"schema\"] == \"P7_PROC_PROBE_V1\" and response[\"reader_euid\"] == 0\n                    and all(response[\"boot_id\"] == row[\"boot_id\"] for row in candidates), \"探针格式/权限/boot错误\")\n            rows = response[\"rows\"]\n            require(isinstance(rows, list) and all(isinstance(r, dict) for r in rows)\n                    and len(rows) == len(candidates) and [r[\"pid\"] for r in rows] == [r[\"pid\"] for r in candidates], \"探针PID批次不对应\")\n            for expected, row in zip(candidates, rows):\n                status = row[\"status\"]\n                if status == \"observed\":\n                    require(isinstance(row.get(\"identity\"), dict) and isinstance(row.get(\"before\"), dict)\n                            and isinstance(row.get(\"after\"), dict), \"探针缺完整身份记录\")\n                    require(_PROC_READER[\"_stable\"](expected, row[\"before\"])\n                            and _PROC_READER[\"_stable\"](expected, row[\"after\"])\n                            and _PROC_READER[\"_stable\"](expected, row[\"identity\"]), \"探针PID/start/boot身份不对应\")\n                    require(isinstance(row[\"identity\"][\"argv\"], list)\n                            and all(isinstance(a, str) for a in row[\"identity\"][\"argv\"])\n                            and (isinstance(row[\"identity\"][\"exe\"], str) and row[\"identity\"][\"exe\"].startswith(\"/\")\n                                 or row[\"identity\"][\"exe\"] is None and row[\"identity\"].get(\"zombie\") is True and row[\"identity\"][\"state\"] == \"Z\"), \"探针exe/argv不完整\")\n                    classify(row)\n                elif status == \"vanished\":\n                    require(\"before\" not in row or _PROC_READER[\"_stable\"](expected, row[\"before\"]), \"消失回执身份不符\")\n                    vanished.append({\"expected\": expected, \"probe\": row})\n                else:\n                    unreadable.append({\"expected\": expected, \"probe\": row})\n        except (OSError, ValueError, KeyError, TypeError, IndexError, subprocess.SubprocessError) as error:\n            unreadable.extend({\"pid\": row[\"pid\"], \"expected\": row, \"error\": repr(error)} for row in candidates)\n    return {\"related\": related, \"unreadable\": unreadable, \"vanished\": vanished,\n            \"ordinary_denied\": denied, \"privileged_probe\": probe, \"clean\": not related and not unreadable}\n\n\ndef inspect_runtime_preconditions(trust=TRUST):\n    \"\"\"当前普通运行身份的只读前置；不建目录、不碰marker、不调用任何子进程。\"\"\"\n    account = pwd.getpwnam(\"loosqk\")\n    info = trust.lstat()\n    return {\"schema\": \"P7_RUNTIME_PRECONDITIONS_V1\", \"uid\": os.getuid(), \"euid\": os.geteuid(),\n            \"gid\": os.getgid(), \"egid\": os.getegid(), \"account_uid\": account.pw_uid, \"account_gid\": account.pw_gid,\n            \"machine\": os.uname().machine, \"python_version\": list(sys.version_info[:3]),\n            \"rtprio\": list(resource.getrlimit(resource.RLIMIT_RTPRIO)),\n            \"memlock\": list(resource.getrlimit(resource.RLIMIT_MEMLOCK)),\n            \"tools\": {name: shutil.which(name) for name in (\"taskset\", \"git\", \"systemctl\", \"udevadm\", \"fuser\", \"sha256sum\", \"sudo\")},\n            \"trust\": {\"path\": str(trust), \"mode\": stat.S_IMODE(info.st_mode), \"uid\": info.st_uid,\n                      \"gid\": info.st_gid, \"device\": info.st_dev, \"inode\": info.st_ino,\n                      \"is_directory\": stat.S_ISDIR(info.st_mode), \"is_symlink\": stat.S_ISLNK(info.st_mode)}}\n\n\ndef validate_runtime_preconditions(value, trust=TRUST):\n    require(value[\"schema\"] == \"P7_RUNTIME_PRECONDITIONS_V1\", \"运行前置schema不符\")\n    require(value[\"uid\"] == value[\"euid\"] == value[\"account_uid\"]\n            and value[\"gid\"] == value[\"egid\"] == value[\"account_gid\"], \"必须以loosqk实际身份运行\")\n    require(value[\"machine\"] == \"aarch64\" and value[\"python_version\"] >= [3, 11, 0], \"运行架构/Python版本不符\")\n    require(set(value[\"tools\"]) == {\"taskset\", \"git\", \"systemctl\", \"udevadm\", \"fuser\", \"sha256sum\", \"sudo\"}\n            and all(value[\"tools\"].values()), \"缺少必要运行工具\")\n    require(value[\"rtprio\"][0] == resource.RLIM_INFINITY or value[\"rtprio\"][0] >= 70, \"实际身份没有FIFO70权限\")\n    require(value[\"memlock\"][0] == resource.RLIM_INFINITY, \"实际身份没有无限MEMLOCK预算\")\n    require(value[\"trust\"][\"path\"] == str(trust), \"运行前置TRUST路径与所选侧不符\")\n    trust = value[\"trust\"]\n    require(trust[\"is_directory\"] and not trust[\"is_symlink\"] and trust[\"uid\"] == value[\"account_uid\"]\n            and trust[\"gid\"] == value[\"account_gid\"] and trust[\"mode\"] == 0o750, \"trust目录权限不符\")\n    return value\n\n\ndef marker_snapshot(directory, expected=None, uid=None, gid=None):\n    \"\"\"只读双份严格字节与所有权；绝不直接写 marker。\"\"\"\n    result = {}\n    for name in (\"rx_trust_marker\", \"rx_trust_marker.bak\"):\n        path = directory / name\n        try:\n            metadata = path.lstat()\n        except FileNotFoundError:\n            require(expected is None, f\"缺少 marker：{name}\")\n            result[name] = {\"missing\": True}\n            continue\n        require(stat.S_ISREG(metadata.st_mode) and metadata.st_nlink == 1, f\"marker 对象错误：{name}\")\n        with path.open(\"rb\") as source:\n            data = source.read(3)\n        require(metadata.st_size <= 3, \"marker 大小异常\")\n        result[name] = {\"hex\": data.hex(), \"uid\": metadata.st_uid, \"gid\": metadata.st_gid,\n                        \"mode\": stat.S_IMODE(metadata.st_mode), \"sha256\": hashlib.sha256(data).hexdigest()}\n        require(metadata.st_uid == uid and metadata.st_gid == gid and stat.S_IMODE(metadata.st_mode) == 0o600,\n                f\"marker 权限/属主错误：{name}\")\n        if expected is not None:\n            require(data == expected, f\"marker 未处于预期阶段：{name}\")\n    return result\n\n\ndef validate_services(output):\n    found = {}\n    for block in output.strip().split(\"\\n\\n\"):\n        fields = {}\n        for line in block.splitlines():\n            key, value = line.split(\"=\", 1)\n            require(key not in fields, \"服务字段重复\")\n            fields[key] = value\n        name = fields[\"Id\"]\n        require(name not in found, \"服务 Id 重复\")\n        found[name] = fields\n    require(set(found) == set(UNITS), \"六服务清单缺失/多项\")\n    for name, row in found.items():\n        require(row[\"LoadState\"] == \"loaded\" and row[\"ActiveState\"] == \"inactive\"\n                and row[\"SubState\"] == \"dead\" and row[\"MainPID\"] == \"0\", f\"服务未停稳：{name}\")\n    return found\n\n\ndef validate_facts(inputs, alignment, physical, options, now_ns):\n    \"\"\"回执由 root 收到本次事实后生成；校验绑定，不替代现场确认。\"\"\"\n    profile = arm_profile(getattr(options, \"side\", \"left\"))\n    require(arm_profile(inputs.get(\"side\", \"left\")) == profile, \"运行输入臂侧与CLI不符\")\n    require(inputs[\"schema\"] == \"P7_H2_INPUTS_V1\" and inputs[\"expected_head\"] == options.expected_head\n            and inputs[\"output\"] == str(options.output), \"运行输入没有绑定本次目录/HEAD\")\n    require(alignment[\"schema\"] == \"P7_H2_ALIGNMENT_V1\" and alignment[\"expected_head\"] == options.expected_head,\n            \"两端对齐回执不符\")\n    hosts = alignment[\"hosts\"]\n    require(len(hosts) == 2 and {row[\"role\"] for row in hosts} == {\"local\", \"orin\"}, \"两端身份不完整\")\n    for row in hosts:\n        require(row[\"head\"] == options.expected_head and row[\"status_porcelain\"] == \"\"\n                and row[\"source_manifest_sha256\"] == inputs[\"source_manifest_sha256\"], \"两端未同HEAD/clean/源\")\n        require(row[\"host\"] and row[\"boot_id\"], \"对齐回执缺主机身份\")\n    require(0 < alignment[\"recorded_at_ns\"] <= now_ns, \"对齐时刻错误\")\n    require(physical[\"schema\"] == \"P7_H2_PHYSICAL_CONFIRMATION_V1\" and physical[\"side\"] == profile.side\n            and physical[\"issued_by\"] == \"root\" and physical[\"expected_head\"] == options.expected_head\n            and physical[\"output\"] == str(options.output), \"现场回执没有绑定本次所选臂运行\")\n    require(physical[\"measurement_manifest_sha256\"] == inputs[\"measurement\"][\"sha256\"]\n            and physical[\"alignment_sha256\"] == inputs[\"alignment\"][\"sha256\"], \"现场回执绑定清单错误\")\n    require(alignment[\"recorded_at_ns\"] <= physical[\"confirmed_at_ns\"] <= now_ns\n            and isinstance(physical[\"source\"], str) and physical[\"source\"].strip(), \"缺本次现场时间/事实来源\")\n    for key in (\"supported\", \"unloaded\", \"area_clear\", \"motor_power_cycle\", \"usb_replug\",\n                \"continuous_presence_until_cleanup\", \"immediate_power_cut\"):\n        require(physical[key] is True, f\"缺少现场事实：{key}\")\n\n\nclass RealBackend:\n    \"\"\"仅显式 execute 使用；构造不运行命令，子进程所有权先于句柄交接。\"\"\"\n    def __init__(self, options, journal):\n        self.options, self.journal = options, journal\n        self.profile = arm_profile(getattr(options, \"side\", \"left\"))\n        self.process = None\n        self.launching = False\n        self.log = None\n        self.inputs = None\n        self.environment = clean_environment(os.environ)\n        self.identities = {}\n\n    def command(self, argv, allowed=(0,)):\n        row = {\"argv\": [str(a) for a in argv], \"started_ns\": time.time_ns()}\n        self.journal.state[\"steps\"].append(row)\n        result = subprocess.run(row[\"argv\"], capture_output=True, text=True, timeout=30,\n                                env=self.environment, check=False)\n        row.update(exit_code=result.returncode, stdout=result.stdout, stderr=result.stderr,\n                   finished_ns=time.time_ns())\n        self.journal.save()\n        require(result.returncode in allowed, f\"命令失败：{row['argv']} exit={result.returncode}\")\n        return result.stdout\n\n    def source_check(self):\n        import post_e_h2_artifacts as artifacts\n        root = Path(self.inputs[\"repository\"])\n        require(root.is_absolute() and root == root.resolve(), \"源码根路径不规范\")\n        head = self.command([\"git\", \"-C\", root, \"rev-parse\", \"HEAD\"]).strip()\n        status = self.command([\"git\", \"-C\", root, \"status\", \"--porcelain=v1\", \"--untracked-files=all\"])\n        require(head == self.options.expected_head and status == \"\", \"实际运行端 HEAD/clean 不符\")\n        names = self.command([\"git\", \"-C\", root, \"ls-files\", \"-z\", \"--cached\", \"--others\", \"--exclude-standard\"])\n        source = artifacts.snapshot_source(root, names.rstrip(\"\\0\").split(\"\\0\"))\n        require(source == pinned_json(self.inputs[\"source\"])\n                and source[\"source_manifest_sha256\"] == self.inputs[\"source_manifest_sha256\"], \"当前编译源发生变化\")\n        orin = next(r for r in self.alignment[\"hosts\"] if r[\"role\"] == \"orin\")\n        require(orin[\"host\"] == os.uname().nodename and orin[\"boot_id\"] ==\n                Path(\"/proc/sys/kernel/random/boot_id\").read_text().strip(), \"运行端不是对齐回执中的 Orin\")\n        self.source = source\n        return {\"head\": head, \"status_porcelain\": status, \"source_manifest_sha256\": source[\"source_manifest_sha256\"]}\n\n    def artifact_check(self):\n        import post_e_h2_artifacts as artifacts\n        result = {}\n        for kind in (\"production\", \"measurement\"):\n            manifest = pinned_json(self.inputs[kind])\n            require(manifest.get(\"schema\") == \"P7_RELEASE_ARTIFACTS_V2\", \"新现场执行只接受 V2 产物合同\")\n            ancestor = False\n            if manifest[\"build_head\"] != self.options.expected_head:\n                self.command([\"git\", \"-C\", self.inputs[\"repository\"], \"merge-base\", \"--is-ancestor\",\n                              manifest[\"build_head\"], self.options.expected_head])\n                for name in (\"run_post_e_h2.py\", \"post_e_h2_report.py\", \"post_e_h2_artifacts.py\"):\n                    frozen_text = self.command([\"git\", \"-C\", self.inputs[\"repository\"], \"show\",\n                                                manifest[\"build_head\"] + \":scripts/\" + name])\n                    require(frozen_text.encode() == (Path(self.inputs[\"repository\"]) / \"scripts\" / name).read_bytes(),\n                            \"继承构建时驱动/报告/共享校验输入改变\")\n                ancestor = True\n            result[kind] = artifacts.validate_artifact_set(manifest, source_manifest=self.source,\n                expected_kind=kind, expected_head=self.options.expected_head, build_ancestor_verified=ancestor)\n            setattr(self, kind, manifest)\n        for key in (\"rustc_before\", \"rustc_after\", \"rustc_identity\"):\n            require(self.production[key] == self.measurement[key], \"生产与测量必须共用同一对 rustc 身份回执\")\n        self.bin_dir = Path(self.measurement[\"artifact_directory\"])\n        require(self.bin_dir != Path(self.production[\"artifact_directory\"]), \"生产/测量冻结目录复用\")\n        return result\n\n    def formal_check(self):\n        import post_e_h2_artifacts as artifacts\n        expected = pinned_json(self.inputs[\"installed\"])\n        actual = artifacts.snapshot_installed(expected)\n        artifacts.validate_installed_snapshot(actual, expected)\n        frozen = [Path(row[\"path\"]) for manifest in (self.production, self.measurement)\n                  for row in manifest[\"artifacts\"].values()]\n        for name in artifacts.INSTALLED_NAMES:\n            installed = Path(actual[\"files\"][\"installed:\" + name][\"path\"])\n            require(all(not installed.samefile(path) for path in frozen), \"冻结件与正式安装件重合\")\n        return actual\n\n    def config_check(self):\n        require(file_hash(self.profile.config) == self.inputs[\"config_sha256\"] ==\n                file_hash(Path(self.inputs[\"repository\"]) / self.profile.repository_config), \"D2配置身份不符\")\n        config = tomllib.loads(self.profile.config.read_text())\n        require(config[\"robot\"][\"id\"] == self.profile.robot_id and len(config[\"hardware\"]) == 1, \"非所选臂独占配置\")\n        hw = config[\"hardware\"][0]\n        require(hw[\"id\"] == self.profile.hardware_id and hw[\"address\"] == self.profile.device\n                and hw[\"adapter\"] == \"feetech_sts3215\" and hw[\"motor_ids\"] == list(range(1, 7))\n                and hw[\"auto_enable\"] is False and len(hw[\"calibration_paths\"]) == 1, \"D2硬件字段改变\")\n        calibration = Path(hw[\"calibration_paths\"][0])\n        require(calibration.is_absolute() and calibration.name == self.profile.calibration_name\n                and str(calibration) == self.inputs[\"calibration\"][\"path\"]\n                and file_hash(calibration) == self.inputs[\"calibration\"][\"sha256\"], \"Python标定身份改变\")\n        strict_json(calibration.read_text())\n        return {\"config_sha256\": file_hash(self.profile.config), \"calibration_sha256\": file_hash(calibration)}\n\n    def device_check(self):\n        lines = self.command([\"udevadm\", \"info\", \"--query=property\", \"--name\", self.profile.device]).splitlines()\n        for key, value in {\"ID_VENDOR_ID\": \"1a86\", \"ID_MODEL_ID\": \"55d3\",\n                           \"ID_SERIAL_SHORT\": self.profile.usb_serial, \"ID_USB_DRIVER\": \"cdc_acm\"}.items():\n            require([line for line in lines if line.startswith(key + \"=\")] == [key + \"=\" + value], \"USB身份不唯一/不符\")\n        info = Path(self.profile.device).stat()\n        require(stat.S_ISCHR(info.st_mode) and os.access(self.profile.device, os.R_OK | os.W_OK), \"串口类型/权限不符\")\n        output = self.command([\"fuser\", self.profile.device], allowed=(1,))\n        last = self.journal.state[\"steps\"][-1]\n        require(not output.strip() and not last[\"stderr\"].strip(), \"fuser错误不能当成空闲\")\n        return {\"path\": self.profile.device, \"resolved\": str(Path(self.profile.device).resolve()), \"rdev\": info.st_rdev,\n                \"uid\": info.st_uid, \"gid\": info.st_gid, \"mode\": stat.S_IMODE(info.st_mode)}\n\n    def preflight(self):\n        self.inputs = pinned_json({\"path\": str(self.options.inputs), \"sha256\": self.options.inputs_sha256})\n        self.alignment = pinned_json(self.inputs[\"alignment\"])\n        physical = pinned_json(self.inputs[\"physical\"])\n        validate_facts(self.inputs, self.alignment, physical, self.options, time.time_ns())\n        runtime = inspect_runtime_preconditions(self.profile.trust)\n        self.uid, self.gid = runtime[\"account_uid\"], runtime[\"account_gid\"]\n        self.journal.state.update(physical=physical, alignment=self.alignment, runtime_preconditions=runtime,\n                                  limits={key: runtime[key] for key in (\"rtprio\", \"memlock\")},\n                                  actual_uid=runtime[\"uid\"], actual_gid=runtime[\"gid\"],\n                                  environment_keys=sorted(self.environment))\n        self.journal.save()\n        validate_runtime_preconditions(runtime, self.profile.trust)\n\n    def audit(self):\n        require(self.inputs is not None, \"未通过输入预检\")\n        require(pinned_json({\"path\": str(self.options.inputs), \"sha256\": self.options.inputs_sha256}) == self.inputs, \"输入变化\")\n        require(pinned_json(self.inputs[\"alignment\"]) == self.alignment, \"两端对齐证据变化\")\n        require(pinned_json(self.inputs[\"physical\"]) == self.journal.state[\"physical\"], \"物理事实回执变化\")\n        source = self.source_check()\n        artifacts = self.artifact_check()\n        formal = self.formal_check()\n        config = self.config_check()\n        device = self.device_check()\n        if self.process is None:\n            self.cleanup()\n        self.journal.state[\"markers_observed\"] = self.markers(None)\n        return {\"source\": source, \"artifacts\": artifacts, \"formal\": formal, \"config\": config, \"device\": device}\n\n    def trust(self, action):\n        require(action in (\"status\", \"revoke\", \"authorize\"), \"未知维护动作\")\n        return self.command([self.production[\"artifacts\"][\"s0_daemon\"][\"path\"], \"rx-trust\", action,\n                             \"--robot-id\", self.profile.robot_id, \"--rx-trust-dir\", str(self.profile.trust)])\n\n    def markers(self, expected):\n        return marker_snapshot(self.profile.trust, expected, self.uid, self.gid)\n\n    def launch(self):\n        require(self.process is None, \"禁止第二次启动\")\n        self.log = (self.options.output / \"tool.log\").open(\"xb\")\n        argv = tool_command(self.bin_dir, self.options.output, self.profile.side)\n        self.journal.state.update(tool_argv=argv, tool_launch_ns=time.time_ns())\n        self.journal.save()\n        require(not self.journal.state[\"failures\"], \"启动记录失败，拒绝Popen\")\n        # 信号处理器在此窗口只记失败、不抛异常；子进程继承正常信号掩码。\n        self.launching = True\n        try:\n            self.process = subprocess.Popen(argv, stdout=self.log, stderr=subprocess.STDOUT,\n                env=self.environment, start_new_session=True)\n        finally:\n            self.launching = False\n        return self.process\n\n    def identity(self, pid):\n        return process_identity(pid)\n\n    def observe(self, process, journal):\n        if process.poll() is not None:\n            return\n        snapshot = process_snapshot(process.pid, self.options.output,\n                                    [self.bin_dir / name for name in self.measurement[\"artifacts\"]])\n        if snapshot[\"privileged_probe\"] or snapshot[\"unreadable\"]:\n            journal.state[\"last_process_snapshot\"] = snapshot\n            journal.save()\n        if snapshot[\"unreadable\"]:\n            row = snapshot[\"unreadable\"][0] if len(snapshot[\"unreadable\"]) == 1 else {}\n            before, remaining = row.get(\"before\", {}), row.get(\"remaining_stat\", {})\n            expected = journal.state.get(\"launch_identity\", {})\n            identity_fields = {\"pid\", \"start_ticks\", \"boot_id\", \"pgid\", \"uids\"}\n            stat_fields = {\"pid\", \"start_ticks\", \"pgid\"}\n            owned_exit = (process is self.process and journal.state.get(\"tool_pid\") == process.pid\n                and row.get(\"pid\") == process.pid and row.get(\"status\") == \"unreadable\"\n                and row.get(\"error_errno\") == errno.ENOENT\n                and row.get(\"error_filename\") in {\"stat\", \"status\", \"cmdline\", \"exe\"}\n                and isinstance(expected, dict) and isinstance(before, dict) and isinstance(remaining, dict)\n                and identity_fields <= expected.keys() and identity_fields <= before.keys()\n                and expected[\"pid\"] == process.pid and _PROC_READER[\"_stable\"](expected, before)\n                and stat_fields <= remaining.keys()\n                and all(remaining[key] == before[key] for key in stat_fields))\n            require(owned_exit, f\"本轮进程身份不可读：{snapshot}\")\n            # 仅自有child的PID字段退出竞态可由真实wait消解；原扫描和其他失败均保留。\n            started = time.time_ns()\n            exit_code = process.wait(timeout=1)\n            journal.state[\"owned_child_exit_observation\"] = {\n                \"tool_pid\": process.pid, \"launch_identity\": expected, \"snapshot\": snapshot,\n                \"wait_started_ns\": started, \"wait_finished_ns\": time.time_ns(), \"exit_code\": exit_code}\n            journal.save()\n        for row in snapshot[\"related\"]:\n            key = f\"{row['pid']}:{row.get('start_ticks')}\"\n            if key not in self.identities:\n                self.identities[key] = row\n                journal.state[\"observed_processes\"] = list(self.identities.values())\n                journal.save()\n\n    def report(self, pid):\n        expected = {\"side\": self.profile.side, \"bin_dir\": str(self.bin_dir), \"config\": str(self.profile.config),\n                    \"config_sha256\": self.inputs[\"config_sha256\"],\n                    \"calibration_sha256\": self.inputs[\"calibration\"][\"sha256\"], \"tool_pid\": pid,\n                    \"artifacts\": {name: {\"sha256\": row[\"sha256\"], \"build\": pinned_json(row[\"sidecar\"])}\n                                  for name, row in self.measurement[\"artifacts\"].items()}}\n        return verify_report(self.options.output, expected)\n\n    def cleanup(self):\n        require(hasattr(self, \"measurement\"), \"未建立本轮产物身份，无法完成清场核验\")\n        value = process_snapshot(self.process.pid if self.process else -1, self.options.output,\n                                 [self.bin_dir / name for name in self.measurement[\"artifacts\"]])\n        self.journal.state[\"last_process_snapshot\"] = value\n        self.journal.save()\n        require(value[\"clean\"], f\"清场存在残留或不可读身份：{value}\")\n        return value\n\n    def close(self):\n        if self.log is not None:\n            self.log.close()\n\n\nclass Journal:\n    def __init__(self, output, options):\n        self.output = output\n        self.state = {\"schema\": \"P7_H2_RUN_V1\", \"status\": \"RUNNING\", \"started_ns\": time.time_ns(),\n                      \"side\": arm_profile(getattr(options, \"side\", \"left\")).side,\n                      \"expected_head\": options.expected_head, \"inputs_sha256\": options.inputs_sha256,\n                      \"supervisor_pid\": os.getpid(), \"steps\": [], \"failures\": [],\n                      \"authorization_attempts\": 0, \"launch_attempts\": 0, \"deployable\": False, \"D15\": \"OPEN\"}\n\n    def save(self):\n        try:\n            self._save()\n        except OSError as error:\n            self.state[\"status\"] = \"FAIL\"\n            self.state[\"journal_io_failure\"] = repr(error)\n            if not self.state[\"failures\"] or self.state[\"failures\"][-1].get(\"error\") != repr(error):\n                self.state[\"failures\"].append({\"at_ns\": time.time_ns(), \"error\": repr(error)})\n\n    def _save(self):\n        temp = self.output / \"run.json.tmp\"\n        with temp.open(\"w\") as stream:\n            json.dump(self.state, stream, ensure_ascii=False, indent=2)\n            stream.write(\"\\n\"); stream.flush(); os.fsync(stream.fileno())\n        temp.replace(self.output / \"run.json\")\n\n    def fail(self, error):\n        self.state[\"status\"] = \"FAIL\"\n        self.state[\"failures\"].append({\"at_ns\": time.time_ns(), \"error\": str(error)})\n        self.save()\n\n\ndef supervise(process, backend, journal):\n    \"\"\"一旦启动，异常也保留监督并真实 wait；从不重启或 kill 整组。\"\"\"\n    failures = set()\n    while True:\n        try:\n            backend.observe(process, journal)\n        except Exception as error:\n            message = f\"进程观察失败：{error!r}\"\n            if message not in failures:\n                failures.add(message); journal.fail(message)\n        try:\n            result = process.wait(timeout=1)\n            journal.state[\"tool_exit\"] = result\n            journal.state[\"tool_naturally_reaped\"] = True\n            journal.state[\"tool_ended_ns\"] = time.time_ns()\n            journal.save()\n            return result\n        except subprocess.TimeoutExpired:\n            continue\n        except (KeyboardInterrupt, InterruptedError) as error:\n            journal.fail(f\"监督收到中断，继续等待工具实际收尾：{error!r}\")\n\n\ndef execute(options, backend_factory):\n    # 独占目录即消费记录，任何失败也不复用。校验必需参数在此之前完成。\n    options.output.mkdir(exist_ok=False)\n    journal = Journal(options.output, options)\n    backend = backend_factory(options, journal)\n    process = None\n    prior_handlers = {}\n\n    def interrupted(signum, _frame):\n        journal.fail(f\"收到信号 {signum}；不转发、不重授权，已启动工具继续受监督\")\n        if process is None and backend.process is None and not getattr(backend, \"launching\", False):\n            raise InterruptedError(f\"启动前收到信号 {signum}\")\n\n    try:\n        journal.save()\n        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):\n            prior_handlers[sig] = signal.signal(sig, interrupted)\n        backend.preflight()\n        journal.state[\"before\"] = backend.audit()\n        backend.trust(\"status\")\n        backend.trust(\"revoke\")\n        journal.state[\"markers_revoked\"] = backend.markers(b\"1\\n\")\n        backend.trust(\"status\")\n        journal.state[\"authorization_attempts\"] += 1\n        journal.save()\n        require(not journal.state[\"failures\"], \"授权前已有失败\")\n        backend.trust(\"authorize\")\n        journal.state[\"markers_authorized\"] = backend.markers(b\"0\\n\")\n        backend.trust(\"status\")\n        journal.state[\"launch_attempts\"] += 1\n        journal.save()\n        require(not journal.state[\"failures\"], \"启动前已有失败\")\n        process = backend.launch()\n        journal.state[\"tool_pid\"] = process.pid\n        # 身份采集/落证失败仍保 process，必须进入 supervise 完成真实 wait。\n        try:\n            journal.state[\"launch_identity\"] = backend.identity(process.pid)\n            journal.save()\n        except Exception as error:\n            journal.fail(f\"已启动但身份记录失败：{error!r}\")\n        exit_code = supervise(process, backend, journal)\n        require(exit_code == 0, f\"工具原退出码 {exit_code}，保留原始失败\")\n        journal.state[\"report\"] = backend.report(process.pid)\n        require(not journal.state[\"failures\"], \"本轮已记录失败，不能由后续报告覆盖\")\n        journal.state[\"status\"] = \"PASS\"\n    except BaseException as error:\n        process = process if process is not None else backend.process\n        if process is not None:\n            journal.state[\"tool_pid\"] = process.pid\n            if \"launch_identity\" not in journal.state:\n                try:\n                    journal.state[\"launch_identity\"] = backend.identity(process.pid)\n                except Exception as identity_error:\n                    journal.fail(f\"异常启动身份记录失败：{identity_error!r}\")\n        journal.fail(f\"{error!r}\\n{traceback.format_exc()}\")\n        if process is not None and process.poll() is None:\n            journal.state[\"needs_owner_supervision\"] = True\n            supervise(process, backend, journal)\n        elif process is not None and not journal.state.get(\"tool_naturally_reaped\"):\n            journal.state[\"tool_exit\"] = process.wait()\n            journal.state[\"tool_naturally_reaped\"] = True\n        if journal.state[\"authorization_attempts\"] and process is None:\n            try:\n                backend.trust(\"revoke\")\n                journal.state[\"unused_authorization_revoked\"] = backend.markers(b\"1\\n\")\n            except BaseException as revoke_error:\n                journal.fail(f\"未消费授权撤销失败，须人工处置：{revoke_error!r}\")\n    finally:\n        for name, check in ((\"after\", backend.audit), (\"cleanup\", backend.cleanup),\n                            (\"markers_after\", lambda: backend.markers(b\"1\\n\"))):\n            try:\n                journal.state[name] = check()\n            except BaseException as error:\n                journal.fail(f\"最终核验 {name} 失败：{error!r}\")\n        try:\n            backend.close()\n        except Exception as close_error:\n            journal.fail(f\"关闭日志失败：{close_error!r}\")\n        journal.state[\"finished_ns\"] = time.time_ns()\n        journal.save()\n        for sig, previous in prior_handlers.items():\n            signal.signal(sig, previous)\n    return 0 if journal.state[\"status\"] == \"PASS\" else 1\n\n\ndef parse_args(argv=None):\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--side\", choices=(\"left\", \"right\"), default=\"left\")\n    parser.add_argument(\"--execute\", action=\"store_true\")\n    parser.add_argument(\"--physical-reset-confirmed\", action=\"store_true\")\n    parser.add_argument(\"--expected-head\")\n    parser.add_argument(\"--inputs\", type=Path)\n    parser.add_argument(\"--inputs-sha256\")\n    parser.add_argument(\"--output\", type=Path)\n    return parser.parse_args(argv)\n\n\ndef validate_options(options):\n    require(options.physical_reset_confirmed, \"缺少本次现场确认参数\")\n    require(re.fullmatch(r\"[0-9a-f]{40}\", options.expected_head or \"\"), \"expected-head 必须为完整提交 SHA\")\n    require(re.fullmatch(r\"[0-9a-f]{64}\", options.inputs_sha256 or \"\"), \"缺少完整 inputs SHA\")\n    for name in (\"inputs\", \"output\"):\n        value = getattr(options, name)\n        require(value is not None and value.is_absolute() and \"..\" not in value.parts and value == value.resolve(),\n                f\"{name} 必须是明确绝对路径\")\n    require(sys.version_info >= (3, 11), \"驱动需要 uv 选择 Python >=3.11\")\n\n\ndef main(argv=None, backend_factory=None):\n    options = parse_args(argv)\n    if not options.execute:\n        print(json.dumps({\"mode\": \"PLAN_ONLY\", \"side\": options.side, \"deployable\": False,\n                          \"steps\": [\"新run/HEAD/两端clean/源/两套产物/正式安装身份/六服务核验\",\n                                    \"本次现场事实、D2/标定/USB/权限/无持有者\",\n                                    \"status→revoke→status→一次authorize→status→一次工具启动\",\n                                    \"原四组与真实final_stop/自然wait/前后身份及清场核验\"],\n                          \"required\": [\"--execute\", \"--physical-reset-confirmed\", \"--expected-head\",\n                                       \"--inputs\", \"--inputs-sha256\", \"--output\"]}, ensure_ascii=False))\n        return 0\n    try:\n        validate_options(options)\n        return execute(options, backend_factory or RealBackend)\n    except (OSError, ValueError, KeyError) as error:\n        print(f\"执行前拒绝：{error}\", file=sys.stderr)\n        return 2\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "stderr": "", "stdout_sha256": "3b69527eb66115a3770b96ab55aa06d99716270399bb5cf2b0d84c1c9c51b9ae", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 43291, "stderr_bytes": 0}, {"argv": ["git", "-C", "/home/loosqk/robot-checks/h2-exit-observation-20261009-r1/source", "show", "HEAD:scripts/post_e_h2_report.py"], "started_ns": 1791623451844259008, "started_monotonic_ns": 3376701305005319, "pid": 624675, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623451847137401, "elapsed_ns": 2876793, "child_end_class": "EXIT_STATUS", "stdout": "\"\"\"当前 Physical H2 原报告的只读复核；不补造结果、不执行进程或硬件操作。\"\"\"\nfrom __future__ import annotations\n\nimport csv\nfrom dataclasses import dataclass\nimport hashlib\nimport io\nimport json\nimport re\nfrom pathlib import Path\n\n\ndef require(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\n@dataclass(frozen=True)\nclass ArmProfile:\n    side: str\n    robot_id: str\n    hardware_id: str\n    config: Path\n    repository_config: Path\n    trust: Path\n    device: str\n    usb_serial: str\n    calibration_name: str\n    evidence_directory: str\n    serial_cpu: int\n\n\ndef arm_profile(side=\"left\"):\n    \"\"\"仅允许已冻结 D2 的两侧，不接受输入文件自定义硬件映射。\"\"\"\n    require(isinstance(side, str) and side in (\"left\", \"right\"), \"未知臂侧\")\n    serial, cpu = (\"5A7C121427\", 4) if side == \"left\" else (\"5A7C122340\", 5)\n    return ArmProfile(side, f\"xlerobot_{side}\", f\"{side}_arm\",\n                      Path(f\"/etc/robot/xlerobot_{side}_arm.toml\"),\n                      Path(f\"configs/xlerobot_{side}_arm.toml\"),\n                      Path(f\"/var/lib/robot/xlerobot_{side}\"),\n                      f\"/dev/serial/by-id/usb-1a86_USB_Single_Serial_{serial}-if00\",\n                      serial, f\"{side}_arm.json\", f\"orin_sla_{side}\", cpu)\n\n\ndef strict_json(text):\n    def pairs(items):\n        value = {}\n        for key, item in items:\n            require(key not in value, f\"JSON 重复字段：{key}\")\n            value[key] = item\n        return value\n\n    def invalid(value):\n        raise ValueError(f\"JSON 非有限常量：{value}\")\n\n    return json.loads(text, object_pairs_hook=pairs, parse_constant=invalid)\n\n\ndef integer(value, label, minimum=0):\n    require(type(value) is int and value >= minimum, f\"{label} 必须为整数且 >= {minimum}\")\n    return value\n\n\ndef nonempty(value, label):\n    require(isinstance(value, str) and value.strip(), f\"{label} 为空\")\n    return value\n\n\ndef distribution(values):\n    require(values, \"分布没有原始值\")\n    ordered = sorted(values)\n    return {\"count\": len(values), \"p50\": ordered[(len(values) * 50 + 99) // 100 - 1],\n            \"p99\": ordered[(len(values) * 99 + 99) // 100 - 1], \"max\": ordered[-1]}\n\n\ndef verify_ack(ack, request_id, dry_run):\n    require(ack.get(\"ok\") is True and ack.get(\"kind\") == \"ack\", \"未取得真实成功 Ack\")\n    require(ack.get(\"request_id\") == nonempty(request_id, \"请求 ID\"), \"Ack 请求身份错误\")\n    require(ack.get(\"dry_run\") is dry_run, \"Ack dry_run 错误\")\n    integer(ack.get(\"cleared_at_ns\"), \"Ack 完成戳\", 1)\n\n\ndef verify_final_stop(value, boundaries):\n    require(value.get(\"ok\") is True, \"final_stop 未成功\")\n    require(re.fullmatch(r\"Ok\\([1-9][0-9]*\\)\", value.get(\"estop\", \"\")), \"ExternalEStop 未成功\")\n    disarm = value.get(\"disarmed\", \"\")\n    match = re.fullmatch(r\"Ok\\(\\(([1-9][0-9]*), BoundarySnapshot \\{ .+ \\}\\)\\)\", disarm)\n    require(match, \"Disarm 缺真实成功回执\")\n    require(\"failure: None\" in disarm and \"status: Disarmed\" in disarm\n            and \"armed_seq: 0,\" in disarm, \"Disarm 含残余或 sticky failure\")\n    last = boundaries[-1]\n    require(last[\"mode\"] == \"Disarm\" and last[\"sequence\"] == int(match[1]),\n            \"最终 Disarm 与原 boundary 不对应\")\n    state = value.get(\"get_state\", {})\n    require(state.get(\"attempted\") is True and state.get(\"ok\") is True\n            and state.get(\"safety_state\") == 3, \"未取得真实 GetState 状态3\")\n    integer(state.get(\"state_stamp_ns\"), \"GetState 时间戳\", 1)\n    disable = value.get(\"disable\", {})\n    require(disable.get(\"attempted\") is True, \"Disable 未执行\")\n    request = disable.get(\"request\", {})\n    require(request.get(\"enabled\") is False and request.get(\"dry_run\") is False,\n            \"最终请求不是 live Disable\")\n    nonempty(request.get(\"idempotency_key\"), \"Disable 幂等键\")\n    verify_ack(disable, request.get(\"request_id\"), False)\n    start = integer(disable.get(\"started_ns\"), \"Disable 开始\", 1)\n    require(integer(disable.get(\"finished_ns\"), \"Disable 结束\", 1) >= start, \"Disable 时间倒序\")\n\n\ndef verify_final_trace(value, boundaries):\n    \"\"\"最终 child stop 后的测量有效性门；不替代真实 final_stop 安全回执。\"\"\"\n    require(value[\"valid\"] is True and value[\"children_stopped\"] is True\n            and value[\"installed\"] is True and value[\"error\"] is None\n            and value[\"read_error\"] is None, \"最终 trace 未确认有效/停止/安装\")\n    require(integer(value[\"dropped\"], \"最终丢事件\") == 0, \"最终 trace 丢事件\")\n    snap = value[\"boundary\"]\n    require(isinstance(snap, dict), \"最终采样边界未知\")\n    sequence = integer(snap[\"request_seq\"], \"最终请求序号\", 1)\n    require(integer(snap[\"receipt_seq\"], \"最终回执序号\", 1) == sequence\n            and sequence == boundaries[-1][\"sequence\"] and boundaries[-1][\"mode\"] == \"Disarm\",\n            \"最终 trace 与最终 Disarm 不对应\")\n    require(snap[\"request_mode\"] == snap[\"mode\"] == \"Some(Disarm)\"\n            and snap[\"status\"] == \"Disarmed\" and snap[\"gate_active\"] is False\n            and snap[\"failure\"] == \"None\", \"最终采样边界含未知/残余/sticky状态\")\n    require(integer(snap[\"armed_seq\"], \"最终armed序号\") == 0\n            and integer(snap[\"failure_seq\"], \"最终失败序号\") == 0, \"最终采样仍armed或锁存失败\")\n\n\ndef verify_rt(value, tool_pid, side=\"left\"):\n    profile = arm_profile(side)\n    require(value.get(\"passed\") is True, \"PX-56 未通过\")\n    require(value.get(\"profile\") == {\"serial_cpu\": profile.serial_cpu, \"serial_policy\": 1,\n            \"serial_priority\": 70, \"ordinary_policy\": 0, \"ordinary_priority\": 0,\n            \"ordinary_cpus\": [0, 1, 2, 3]}, \"PX-56 所选臂 profile 改变\")\n    require(0 < value[\"started_ns\"] <= value[\"finished_ns\"], \"PX-56 时间错误\")\n    rows = value.get(\"processes\", [])\n    require(len(rows) == 3 and {r[\"role\"] for r in rows} == {\"tool\", \"s0\", \"gateway\"},\n            \"PX-56 进程范围错误\")\n    pids = {}\n    for row in rows:\n        require(row.get(\"validation_error\") is None, \"PX-56 有原始错误\")\n        snapshot = row[\"snapshot\"]\n        pid = integer(snapshot[\"pid\"], \"PX-56 PID\", 1)\n        pids[row[\"role\"]] = pid\n        tids = snapshot[\"tids_before\"]\n        require(snapshot[\"errors\"] == [] and tids and tids == sorted(set(tids))\n                and tids == snapshot[\"tids_after\"] and pid in tids, \"TID 清单不完整/不稳定\")\n        threads = snapshot[\"threads\"]\n        require(sorted(t[\"tid\"] for t in threads) == tids, \"TID 与调度行不对应\")\n        serial = []\n        for thread in threads:\n            nonempty(thread[\"comm\"], \"线程名\")\n            is_serial = row[\"role\"] == \"s0\" and thread[\"comm\"] == \"s0_serial_io_th\"\n            expected = (1, 70, [profile.serial_cpu]) if is_serial else (0, 0, [0, 1, 2, 3])\n            require((thread[\"policy\"], thread[\"priority\"], thread[\"cpus\"]) == expected,\n                    \"实际线程调度不满足 PX-56\")\n            if is_serial:\n                require(thread[\"tid\"] != pid, \"主线程冒充串口线程\")\n                serial.append(thread[\"tid\"])\n        require(len(serial) == (1 if row[\"role\"] == \"s0\" else 0), \"串口线程数量错误\")\n    require(len(set(pids.values())) == 3 and pids[\"tool\"] == tool_pid, \"PX-56 PID 身份错误\")\n    return pids\n\n\ndef verify_background(value):\n    require(value.get(\"valid_responses\") is True and value.get(\"valid_cadence\") is True,\n            \"背景请求/节拍未通过\")\n    require(value.get(\"first_failure\") is None and value.get(\"failures\") == []\n            and value.get(\"admission_rejection\") is None and value.get(\"unfinished\") == [],\n            \"背景存在错误/未完成项\")\n    for key, expected in {\"rr_target_per_second\": 20, \"tracked_limit\": 64,\n                          \"client_timeout_ns\": 2_000_000_000, \"drain_budget_ns\": 2_500_000_000,\n                          \"sigma_probe_period_ns\": 5_000_000}.items():\n        require(value.get(key) == expected, f\"背景预算改变：{key}\")\n    require(1 <= value[\"peak_tracked\"] <= 64, \"背景并发计数错误\")\n    start, stop, drained, end = (integer(value[key], key, 1) for key in\n                               (\"started_ns\", \"stop_ns\", \"drained_ns\", \"finished_ns\"))\n    require(start < stop <= drained <= end and drained - stop <= 2_500_000_000, \"背景 drain 超预算\")\n    requests = value[\"rr_requests\"]\n    require(len(requests) >= 2 and value[\"launched\"] == value[\"completed\"]\n            == value[\"successful_unique_writes\"] == len(requests), \"背景原始行与计数不一致\")\n    keys, ids, starts = set(), set(), []\n    for index, row in enumerate(requests):\n        require(row[\"sequence\"] == index and row[\"due_ns\"] == start + index * 50_000_000,\n                \"背景绝对 due 序列错误\")\n        require(row[\"ok\"] is True and row[\"terminal\"] is True, \"背景有失败原始行\")\n        sent = integer(row[\"started_ns\"], \"背景首poll\", 1)\n        require(row[\"due_ns\"] <= sent < row[\"due_ns\"] + 50_000_000 and sent <= stop,\n                \"背景迟发或 stop 后新增\")\n        require(row[\"deadline_ns\"] == sent + 2_000_000_000\n                and sent <= row[\"finished_ns\"] <= min(row[\"deadline_ns\"], drained), \"背景响应超预算\")\n        verify_ack(row[\"response\"], row[\"request_id\"], True)\n        key = nonempty(row[\"idempotency_key\"], \"背景幂等键\")\n        require(key not in keys and row[\"request_id\"] not in ids, \"背景请求身份重复\")\n        keys.add(key); ids.add(row[\"request_id\"]); starts.append(sent)\n    require(value[\"rr_gap_ns\"] == distribution([b-a for a,b in zip(starts, starts[1:])]),\n            \"背景间隔分布与原始行不同\")\n    sigma = value[\"sigma_raw_ns\"]\n    require(sigma and all(type(n) is int and n >= 0 for n in sigma)\n            and value[\"sigma_est_ns\"] == distribution(sigma), \"调度延迟分布缺失/不一致\")\n    return keys, ids\n\n\ndef verify_boundaries(rows):\n    require(rows, \"缺 boundary 原件\")\n    seen = set()\n    for row in rows:\n        seq = integer(row[\"sequence\"], \"boundary序号\", 1)\n        require(seq not in seen and row.get(\"error\") is None, \"boundary 重复或错误\")\n        seen.add(seq)\n        snap = row[\"snapshot\"]\n        mode = row[\"mode\"]\n        require(mode in (\"ArmIdle\", \"ArmInflight\", \"Disarm\"), \"未知 boundary mode\")\n        require(snap[\"request_seq\"] == snap[\"receipt_seq\"] == seq\n                and snap[\"request_mode\"] == snap[\"mode\"] == f\"Some({mode})\"\n                and snap[\"failure\"] == \"None\", \"boundary 不完整或 sticky failure\")\n        require(0 < row[\"started_ns\"] <= snap[\"ready_ns\"] < snap[\"request_deadline_ns\"]\n                and row[\"finished_ns\"] >= snap[\"ready_ns\"], \"boundary 截止不符\")\n        require((snap[\"status\"] == \"Disarmed\" and snap[\"armed_seq\"] == 0) if mode == \"Disarm\"\n                else (snap[\"status\"] == \"Ready\" and snap[\"armed_seq\"] == seq), \"boundary未真实完成\")\n    return {r[\"sequence\"]: r for r in rows}\n\n\ndef verify_trace(trace, row):\n    \"\"\"复核 Rust analyze 的物理因果链、真实 lease 与 1–5ms 载荷原件。\"\"\"\n    require(trace and [e[\"stamp_ns\"] for e in trace] == sorted(e[\"stamp_ns\"] for e in trace), \"trace 时间未排序\")\n    def unique(kind, success=False):\n        values = [e for e in trace if e[\"kind\"] == kind and (not success or e[\"b\"] == 1)]\n        require(len(values) == 1, f\"trace {kind} 不唯一/缺失\")\n        return values[0]\n    start_kind = \"ExternalEnter\" if row[\"external\"] else \"TopicReceived\"\n    start, primitive, serial, ipc, commit, off = (unique(start_kind), unique(\"PrimitiveCommitted\"),\n        unique(\"SerialClaim\", True), unique(\"IpcClaim\", True), unique(\"IpcEStopCommit\"), unique(\"AllOffTrusted\"))\n    require((start[\"stamp_ns\"], primitive[\"stamp_ns\"], off[\"stamp_ns\"]) ==\n            (row[\"t0_ns\"], row[\"t1_ns\"], row[\"all_off_ns\"]), \"trace与采样时间不对应\")\n    require(primitive[\"b\"] <= 1, \"Merged/LatchOnly不是物理断扭\")\n    faults = {\"CommErrorObserved\", \"FirstCommError\", \"MailboxPublishing\", \"MailboxPublished\", \"FaultIpcCommit\"}\n    bool_kinds = {\"NormalAcquire\", \"NormalRelease\", \"SerialClaim\", \"IpcClaim\", \"SafetyReturn\", \"ConfirmReturn\"}\n    cas_kinds = {\"NormalAcquire\", \"NormalRelease\", \"SerialClaim\", \"IpcClaim\", \"PrimitiveCommitted\"}\n    allowed = bool_kinds | cas_kinds | {start_kind, \"IpcEStopCommit\", \"AllOffTrusted\", \"SafetyStart\", \"InjectedDelay\"}\n    for event in trace:\n        require(event[\"kind\"] in allowed and event[\"kind\"] not in faults\n                and event[\"sample_seq\"] == row[\"sequence\"] and event[\"attempt\"] == row[\"attempt\"]\n                and event[\"external\"] == str(row[\"external\"]).lower(), \"trace混入故障/未知事件/另一轮\")\n        require(event[\"kind\"] == start_kind or event[\"generation\"] == primitive[\"generation\"], \"trace代次拼接\")\n        require(event[\"kind\"] not in bool_kinds or event[\"b\"] <= 1, \"trace成功标志非bool\")\n        require(event[\"kind\"] not in cas_kinds or event[\"a\"] < 2**64-1, \"CAS缺失或耗尽\")\n    active, first, delivered, last_confirm, count, attempts = None, None, None, None, 0, 0\n    for event in trace:\n        kind, stamp = event[\"kind\"], event[\"stamp_ns\"]\n        if kind == \"SafetyStart\":\n            require(active is None and delivered is None and event[\"a\"] == attempts+1 <= 3, \"Safety调用序列错误\")\n            active = event; attempts += 1\n            if first is None: first = stamp\n        elif kind == \"SafetyReturn\":\n            require(active is not None and active[\"a\"] == event[\"a\"] and active[\"stamp_ns\"] <= stamp, \"Safety没有配对\")\n            active = None\n            if event[\"b\"] == 1: delivered = stamp\n        elif kind == \"ConfirmReturn\":\n            require(delivered is not None and delivered <= stamp <= off[\"stamp_ns\"]\n                    and (last_confirm is None or last_confirm < stamp) and event[\"a\"] <= 32 and count < 5, \"Confirm调用非法\")\n            require((event[\"a\"] == 0 and event[\"b\"] == 1) == (stamp == off[\"stamp_ns\"]), \"全关Confirm不对应\")\n            last_confirm = stamp; count += 1\n    require(active is None and delivered is not None and last_confirm == off[\"stamp_ns\"] and first is not None, \"缺完整物理断扭证据\")\n    require(start[\"stamp_ns\"] <= primitive[\"stamp_ns\"] <= serial[\"stamp_ns\"] <= first\n            and primitive[\"stamp_ns\"] <= ipc[\"stamp_ns\"] <= commit[\"stamp_ns\"], \"物理因果顺序错误\")\n    acquired, lease, active_at_commit = None, None, False\n    for event in trace:\n        if event[\"stamp_ns\"] >= off[\"stamp_ns\"] or event[\"b\"] != 1:\n            continue\n        if event[\"kind\"] == \"NormalAcquire\":\n            require(acquired is None and event[\"stamp_ns\"] < primitive[\"stamp_ns\"], \"normal重复或原语后新启\")\n            acquired = event\n        elif event[\"kind\"] == \"NormalRelease\":\n            require(event[\"stamp_ns\"] <= first, \"Safety开始时normal未退\")\n            if acquired is not None:\n                require(acquired[\"normal_seq\"] == event[\"normal_seq\"], \"lease序号错误\")\n                if acquired[\"stamp_ns\"] <= start[\"stamp_ns\"] < event[\"stamp_ns\"]:\n                    lease = (acquired, event)\n                active_at_commit |= acquired[\"stamp_ns\"] <= primitive[\"stamp_ns\"] < event[\"stamp_ns\"]\n                acquired = None\n            else:\n                require(event[\"stamp_ns\"] <= start[\"stamp_ns\"], \"lease缺acquire\")\n    require(acquired is None and bool(primitive[\"b\"]) == active_at_commit, \"ACTIVE与完整lease不符\")\n    require(row[\"matched\"] is ((lease is not None) == row[\"requested_in_flight\"]), \"matched与真实lease分类不符\")\n    if row[\"requested_in_flight\"] and lease is not None:\n        begin, end = lease\n        delays = [e for e in trace if e[\"kind\"] == \"InjectedDelay\" and\n                  (begin[\"stamp_ns\"] <= e[\"stamp_ns\"] <= end[\"stamp_ns\"] or\n                   e[\"stamp_ns\"] < end[\"stamp_ns\"] and e[\"stamp_ns\"]+e[\"b\"] > begin[\"stamp_ns\"])]\n        require(len(delays) == 1, \"在途载荷缺失或重复\")\n        delay = delays[0]\n        require(delay[\"normal_seq\"] == begin[\"normal_seq\"] and 1_000_000 <= delay[\"a\"] <= 5_000_000\n                and delay[\"b\"] >= delay[\"a\"] and begin[\"stamp_ns\"] <= delay[\"stamp_ns\"]\n                and delay[\"stamp_ns\"] + delay[\"b\"] <= end[\"stamp_ns\"], \"1–5ms真实载荷越界或身份不符\")\n\n\ndef verify_report(directory: Path, expected: dict) -> dict:\n    \"\"\"重新读取当前报告/原件并逐项核验；expected 来自已复核的运行清单。\"\"\"\n    directory = Path(directory)\n    profile = arm_profile(expected.get(\"side\", \"left\"))\n    require(expected[\"config\"] == str(profile.config), \"期待配置与所选侧不符\")\n    evidence = directory / profile.evidence_directory\n    hashes = {}\n\n    def read(path):\n        require(path.is_file() and not path.is_symlink(), f\"原件缺失或非普通文件：{path}\")\n        content = path.read_bytes()\n        require(content, f\"原件为空：{path}\")\n        hashes[str(path.relative_to(directory))] = hashlib.sha256(content).hexdigest()\n        return content.decode()\n\n    def json_file(name):\n        return strict_json(read(evidence / name))\n\n    report = strict_json(read(directory / \"report.json\"))\n    require(report[\"schema_version\"] == 1 and report[\"status\"] == \"PASS\"\n            and report[\"hardware\"] == {\"H1\": \"NEEDS_HUMAN\", \"H2\": \"PASS\",\n                                       \"H3\": \"NEEDS_HUMAN\", \"D15\": \"OPEN\"}, \"不是完整 H2 PASS 原报告\")\n    invocation = report[\"invocation\"]\n    require(invocation[\"phase\"] == \"OrinSla\" and invocation[\"case_filter\"] is None\n            and invocation[\"hardware_id\"] == profile.hardware_id and invocation[\"config\"] == expected[\"config\"]\n            and invocation[\"config_sha256\"] == expected[\"config_sha256\"], \"报告调用身份错误\")\n    bin_dir = Path(expected[\"bin_dir\"])\n    require(invocation[\"current_exe\"] == str(bin_dir / \"comm_fault_e2e\")\n            and invocation[\"current_exe_sha256\"] == expected[\"artifacts\"][\"comm_fault_e2e\"][\"sha256\"],\n            \"报告 current_exe 错误\")\n    artifacts = report[\"artifacts\"]\n    require(len(artifacts) == 3 and {a[\"name\"] for a in artifacts} == set(expected[\"artifacts\"]),\n            \"报告三件身份不完整\")\n    for artifact in artifacts:\n        actual = expected[\"artifacts\"][artifact[\"name\"]]\n        require(artifact[\"path\"] == str(bin_dir / artifact[\"name\"])\n                and artifact[\"sha256\"] == actual[\"sha256\"] and artifact[\"build\"] == actual[\"build\"],\n                \"报告产物与已冻结清单不同\")\n    cases = report[\"cases\"]\n    require(len(cases) == 1 and cases[0][\"case\"] == \"orin_sla\"\n            and cases[0][\"ac\"] == \"AC-12/H2\" and cases[0][\"status\"] == \"PASS\", \"H2 场景错误\")\n    result = cases[0][\"evidence\"]\n    environment = json_file(\"environment.json\")\n    require(result[\"environment\"] == environment, \"环境原件与报告不同\")\n    for key, value in {\"gateway_idempotency_max_entries\": 8192, \"gateway_idempotency_ttl_secs\": 300,\n                       \"background_tracked_limit\": 64, \"wire_active_limit_unchanged\": 4,\n                       \"s48_cache_observation\": False, \"hardware_id\": profile.hardware_id,\n                       \"address\": profile.device,\n                       \"current_exe\": str(bin_dir / \"comm_fault_e2e\"),\n                       \"config_sha256\": expected[\"config_sha256\"],\n                       \"calibration_sha256\": expected[\"calibration_sha256\"]}.items():\n        require(environment.get(key) == value, f\"Physical 环境字段错误：{key}\")\n    require(environment[\"artifacts\"] == {role: expected[\"artifacts\"][name][\"build\"] for role, name in\n            ((\"tool\", \"comm_fault_e2e\"), (\"s0\", \"s0_daemon\"), (\"gateway\", \"robot_rpc_gateway\"))},\n            \"Physical 预检产物与报告不同\")\n    gateway_args = environment[\"gateway_arguments\"]\n    for flag, value in ((\"--idempotency-max-entries\", \"8192\"), (\"--idempotency-ttl-secs\", \"300\")):\n        require(gateway_args.count(flag) == 1 and gateway_args[gateway_args.index(flag) + 1] == value,\n                \"Gateway 实际参数未保原容量/TTL\")\n    rt = json_file(\"rt_preflight.json\")\n    require(rt == result[\"rt_preflight\"], \"RT 原件与报告不同\")\n    pids = verify_rt(rt, expected[\"tool_pid\"], profile.side)\n    boundaries = [strict_json(line) for line in read(evidence / \"boundary.jsonl\").splitlines()]\n    boundary_index = verify_boundaries(boundaries)\n    final = json_file(\"final_stop.json\")\n    require(final == result[\"final_state\"], \"final_stop 原件与报告不同\")\n    verify_final_stop(final, boundaries)\n    final_trace = json_file(\"final_trace.json\")\n    require(json.dumps(final_trace, sort_keys=True) == json.dumps(result[\"final_trace\"], sort_keys=True),\n            \"final_trace 原件与报告不同\")\n    verify_final_trace(final_trace, boundaries)\n    measurement = result[\"measurement\"]\n    for key, value in {\"trace_dropped\": 0, \"hardware_only\": True, \"runtime_only\": False,\n                       \"in_flight_exercised\": True, \"mock_lease\": False,\n                       \"external_entry_exercised\": True, \"topic_entry_exercised\": True,\n                       \"idle_exercised\": True, \"events_csv\": str(evidence / \"events.csv\")}.items():\n        require(measurement.get(key) == value, f\"Physical 测量字段错误：{key}\")\n    background = json_file(\"background.json\")\n    require(background == measurement[\"background\"], \"背景原件与报告不同\")\n    keys, ids = verify_background(background)\n    attempts = [strict_json(line) for line in read(evidence / \"attempts.jsonl\").splitlines()]\n    require(attempts, \"没有采样原件\")\n    require(len(boundaries) == 2 * len(attempts) + 1, \"逐次Arm/Disarm原件缺失或增项\")\n    for index, attempt in enumerate(attempts):\n        armed, disarmed = boundaries[2*index:2*index+2]\n        require(armed[\"sequence\"] == attempt[\"sequence\"] and disarmed[\"mode\"] == \"Disarm\"\n                and armed[\"finished_ns\"] <= attempt[\"t0_ns\"] <= attempt[\"all_off_ns\"] <= disarmed[\"started_ns\"],\n                \"逐次Arm/Disarm次序或物理收尾不对应\")\n    groups = measurement[\"groups\"]\n    expected_groups = [(False, False), (False, True), (True, False), (True, True)]\n    require([(g[\"external\"], g[\"in_flight\"]) for g in groups] == expected_groups, \"四组缺失/重复/乱序\")\n    events = {}\n    raw = csv.DictReader(io.StringIO(read(evidence / \"events.csv\")))\n    require(raw.fieldnames == [\"attempt\", \"external\", \"sample_seq\", \"stamp_ns\", \"kind\", \"source\",\n                              \"normal_seq\", \"generation\", \"a\", \"b\"], \"原始 trace 列错误\")\n    for row in raw:\n        for key in (\"attempt\", \"sample_seq\", \"stamp_ns\", \"source\", \"normal_seq\", \"generation\", \"a\", \"b\"):\n            row[key] = integer(int(row[key]), f\"trace {key}\")\n        require(row[\"external\"] in (\"true\", \"false\"), \"trace 入口类型错误\")\n        events.setdefault(row[\"sample_seq\"], []).append(row)\n    seen_sequences, ordered_groups = set(), []\n    for group, identity in zip(groups, expected_groups):\n        require(json_file(f\"sla_{str(identity[0]).lower()}_{str(identity[1]).lower()}.json\") == group,\n                \"组原件与报告不同\")\n        rows = [r for r in attempts if (r.get(\"external\"), r.get(\"requested_in_flight\")) == identity]\n        require(1100 <= len(rows) <= 11000, \"组尝试数越界\")\n        accepted, a_values, b_values, retries = 0, [], [], []\n        cas = {\"NormalAcquire\": [], \"SerialClaim\": [], \"IpcClaim\": []}\n        for index, row in enumerate(rows):\n            require(row.get(\"invalid\") is not True and row[\"attempt\"] == index\n                    and row[\"warmup\"] is (accepted < 100) and type(row[\"matched\"]) is bool, \"采样尝试非法\")\n            seq = integer(row[\"sequence\"], \"采样序号\", 1)\n            require(seq not in seen_sequences and seq in boundary_index, \"采样序号重复/缺边界\")\n            seen_sequences.add(seq); ordered_groups.append(identity)\n            boundary = boundary_index[seq]\n            require(boundary[\"mode\"] == (\"ArmInflight\" if identity[1] else \"ArmIdle\"), \"采样边界类型不符\")\n            require(rt[\"finished_ns\"] <= row[\"t0_ns\"] <= row[\"t1_ns\"] <= row[\"all_off_ns\"], \"采样时序/PX-56顺序错误\")\n            trace = events.get(seq, [])\n            verify_trace(trace, row)\n            require(all(e[\"external\"] == str(identity[0]).lower() for e in trace), \"trace 混入另一入口\")\n            for kind, stamp in [(\"ExternalEnter\" if identity[0] else \"TopicReceived\", row[\"t0_ns\"]),\n                                (\"PrimitiveCommitted\", row[\"t1_ns\"]), (\"AllOffTrusted\", row[\"all_off_ns\"])]:\n                matching = [e for e in trace if e[\"kind\"] == kind]\n                require(len(matching) == 1 and matching[0][\"stamp_ns\"] == stamp, \"采样与真实 trace 不对应\")\n            if row[\"matched\"]:\n                if accepted >= 100:\n                    a_values.append(row[\"t1_ns\"] - row[\"t0_ns\"])\n                    b_values.append(row[\"all_off_ns\"] - row[\"t0_ns\"])\n                    retries.append(next(e[\"a\"] for e in trace if e[\"kind\"] == \"PrimitiveCommitted\"))\n                    for kind, values in cas.items():\n                        values.extend(e[\"a\"] for e in trace if e[\"kind\"] == kind)\n                accepted += 1\n        require(accepted == 1100 and group[\"warmup\"] == 100 and group[\"samples\"] == 1000\n                and group[\"class_mismatch_retries\"] == len(rows) - 1100 and group[\"passed\"] is True,\n                \"原100预热+1000样本不完整\")\n        require(group[\"sla_a_ns\"] == distribution(a_values) and group[\"sla_b_ns\"] == distribution(b_values)\n                and group[\"primitive_cas_retries\"] == distribution(retries), \"组分布与原样本不同\")\n        for kind, field in ((\"NormalAcquire\", \"acquire_cas_retries\"), (\"SerialClaim\", \"serial_claim_cas_retries\"),\n                            (\"IpcClaim\", \"ipc_claim_cas_retries\")):\n            require(group[field] == (distribution(cas[kind]) if cas[kind] else None), \"CAS 分布与原trace不同\")\n        target = 75_000_000 if identity[1] else 20_000_000\n        require(group[\"sla_b_target_ns\"] == target and group[\"sla_a_ns\"][\"p99\"] <= 2_000_000\n                and group[\"sla_b_ns\"][\"p99\"] <= target, \"原 P99 预算未满足\")\n    require(set(events) == seen_sequences, \"trace混入未采样epoch\")\n    require(len(seen_sequences) == len(attempts)\n            and [(r[\"external\"], r[\"requested_in_flight\"]) for r in attempts] == ordered_groups,\n            \"尝试原件混入未知组或顺序改变\")\n    require(background[\"started_ns\"] <= attempts[0][\"t0_ns\"]\n            and attempts[-1][\"all_off_ns\"] <= background[\"stop_ns\"], \"背景窗口未覆盖完整测量\")\n    recoveries = json_file(\"recovery_writes.json\")\n    require(len(recoveries) == 2 * len(attempts), \"恢复请求与尝试数量不对应\")\n    for index, row in enumerate(recoveries):\n        require(row[\"method\"] == (\"ClearEStop\" if index % 2 == 0 else \"SetEnabled(true)\")\n                and row[\"ok\"] is True and rt[\"finished_ns\"] <= row[\"started_ns\"] <= row[\"finished_ns\"]\n                <= attempts[index // 2][\"t0_ns\"], \"恢复写失败/顺序错误\")\n        if index % 2:\n            require(row[\"started_ns\"] >= recoveries[index-1][\"finished_ns\"], \"Clear/Enable次序错误\")\n        else:\n            previous = attempts[index//2-1][\"all_off_ns\"] if index else rt[\"finished_ns\"]\n            require(row[\"started_ns\"] >= previous + 600_000_000, \"恢复600ms窗口缩短\")\n        verify_ack(row[\"response\"], row[\"request_id\"], False)\n        require(row[\"idempotency_key\"] not in keys and row[\"request_id\"] not in ids, \"真实新写身份重复\")\n        keys.add(nonempty(row[\"idempotency_key\"], \"恢复幂等键\")); ids.add(row[\"request_id\"])\n    require(final[\"disable\"][\"request\"][\"idempotency_key\"] not in keys\n            and final[\"disable\"][\"request\"][\"request_id\"] not in ids, \"最终 Disable 重用了旧身份\")\n    for name in (\"s0.stdout.log\", \"s0.stderr.log\", \"gateway.stdout.log\", \"gateway.stderr.log\"):\n        path = evidence / name\n        require(path.is_file() and not path.is_symlink(), f\"缺进程日志：{name}\")\n        hashes[str(path.relative_to(directory))] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return {\"status\": \"PASS\", \"groups\": 4, \"samples\": 4000, \"warmup\": 400,\n            \"attempts\": len(attempts), \"pids\": pids, \"original_hashes\": hashes,\n            \"child_stop_basis\": \"原始PASS仅在真实gateway/S0 stop各退出0后生成；另核外层PID清场\",\n            \"deployable\": False, \"D15\": \"OPEN\"}\n", "stderr": "", "stdout_sha256": "bd35923146c3841ec5f4547b85b99494abbd93970cb1b805ce0fb7692b368387", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 28682, "stderr_bytes": 0}, {"argv": ["git", "-C", "/home/loosqk/robot-checks/h2-exit-observation-20261009-r1/source", "show", "HEAD:scripts/post_e_h2_artifacts.py"], "started_ns": 1791623451848362129, "started_monotonic_ns": 3376701309108440, "pid": 624676, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623451851185705, "elapsed_ns": 2821976, "child_end_class": "EXIT_STATUS", "stdout": "\"\"\"P.7 专用的产物、编译输入及安装状态只读验证；导入不执行外部命令。\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path, PurePosixPath\nimport re\nimport shlex\nimport stat\nimport subprocess\n\nTOOLCHAIN = \"nightly\"\n# 仅显式历史验读使用；新准备与现场 execute 不接受旧合同。\nLEGACY_TOOLCHAIN = \"nightly-2026-09-10\"\nLEGACY_RUSTC_COMMIT = \"a36d05efab632d1ddf902b6a5c33b6d5d3b64131\"\nINPUT_DOMAINS = (\n    \"Cargo.toml\", \"Cargo.lock\", \"rust-toolchain.toml\", \".cargo\", \"crates\", \"configs\",\n    \"3rd-party/Cargo.toml\", \"3rd-party/Cargo.lock\", \"3rd-party/iceoryx2\",\n    \"3rd-party/iceoryx2-cal\", \"3rd-party/flatc\", \"tools/rr-memory-model\",\n)\nBUSINESS_UNITS = (\n    \"xlerobot-s0-left-arm.service\", \"xlerobot-s0-right-arm.service\",\n    \"xlerobot-s1-left.service\", \"xlerobot-s1-right.service\",\n    \"xlerobot-gateway-left.service\", \"xlerobot-gateway-right.service\",\n)\nHANDOFF_UNIT = \"xlerobot-handoff.service\"\nINSTALLED_NAMES = (\"s0_daemon\", \"xlerobot_deploy\", \"s1_daemon\", \"robot_rpc_gateway\")\n# 参数顺序也属于批准合同，避免偷偷增加 profile、target 或 feature。\nBUILD_SPECS = {\n    \"production\": {\n        \"s0\": (\"robot-s0\", (\"s0_daemon\", \"xlerobot_deploy\"),\n               (\"--features\", \"xlerobot-real\"),\n               (\"default\", \"feetech\", \"mock\", \"xlerobot\", \"xlerobot-real\")),\n        \"s1\": (\"robot-s1\", (\"s1_daemon\",), (),\n               (\"backend-hold-pose\", \"backend-ik\", \"backend-mock-dwell\", \"backend-scripted\", \"default\")),\n        \"gateway\": (\"robot-rpc\", (\"robot_rpc_gateway\",), (\"--no-default-features\",), ()),\n    },\n    \"measurement\": {\n        \"s0\": (\"robot-s0\", (\"s0_daemon\",),\n               (\"--no-default-features\", \"--features\", \"xlerobot-real,rt_guard,test-comm-fault-hook\"),\n               (\"feetech\", \"mock\", \"rt_guard\", \"test-comm-fault-hook\", \"xlerobot\", \"xlerobot-real\")),\n        \"gateway\": (\"robot-rpc\", (\"robot_rpc_gateway\",),\n                    (\"--no-default-features\", \"--features\", \"test-comm-fault-hook\"), (\"test-comm-fault-hook\",)),\n        \"tool\": (\"robot-tests\", (\"comm_fault_e2e\",),\n                 (\"--no-default-features\", \"--features\", \"comm-fault-e2e,real-hw\"),\n                 (\"comm-fault-e2e\", \"comm-fault-rpc\", \"real-hw\")),\n    },\n}\n\n\ndef require(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\ndef canonical(value):\n    return json.dumps(value, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False, allow_nan=False).encode()\n\n\ndef sha256(path):\n    with Path(path).open(\"rb\") as stream:\n        return hashlib.file_digest(stream, \"sha256\").hexdigest()\n\n\ndef strict_json(text):\n    def pairs(items):\n        result = {}\n        for key, value in items:\n            require(key not in result, \"JSON 重复键：\" + key)\n            result[key] = value\n        return result\n\n    def invalid(value):\n        raise ValueError(\"JSON 非有限常量：\" + value)\n\n    return json.loads(text, object_pairs_hook=pairs, parse_constant=invalid)\n\n\ndef _absolute(path):\n    value = Path(path)\n    require(value.is_absolute() and \"..\" not in value.parts, \"要求无越界的绝对路径\")\n    return value\n\n\ndef regular_file(path):\n    value = _absolute(path)\n    info = value.lstat()\n    require(stat.S_ISREG(info.st_mode), \"要求普通文件，拒绝符号链接：\" + str(path))\n    return value, info\n\n\ndef read_pinned_json(reference):\n    path, _ = regular_file(reference[\"path\"])\n    require(sha256(path) == reference[\"sha256\"], \"JSON 文件身份变化：\" + str(path))\n    return strict_json(path.read_text())\n\n\ndef validate_source_manifest(value):\n    require(set(value) == {\"domains\", \"files\", \"source_manifest_sha256\"}, \"编译源清单字段错误\")\n    require(value[\"domains\"] == list(INPUT_DOMAINS) and value[\"files\"], \"编译源域不完整\")\n    for name, item in value[\"files\"].items():\n        path = PurePosixPath(name)\n        require(not path.is_absolute() and \"..\" not in path.parts\n                and str(path) == name and any(name == d or name.startswith(d + \"/\") for d in INPUT_DOMAINS),\n                \"编译源路径越界\")\n        require(set(item) == {\"sha256\", \"bytes\", \"executable\"}\n                and re.fullmatch(r\"[0-9a-f]{64}\", item[\"sha256\"])\n                and type(item[\"bytes\"]) is int and item[\"bytes\"] >= 0\n                and type(item[\"executable\"]) is bool, \"源身份字段错误\")\n    require(value[\"source_manifest_sha256\"] == hashlib.sha256(canonical(value[\"files\"])).hexdigest(),\n            \"编译源清单摘要不匹配\")\n    return value\n\n\ndef snapshot_source(root, inventory):\n    \"\"\"调用者提供 fresh Git 全量 inventory；本函数过滤固定编译域并逐文件读取。\"\"\"\n    root = Path(root).resolve(strict=True)\n    require(len(inventory) == len(set(inventory)), \"Git inventory 有重复路径\")\n    files = {}\n    for name in sorted(inventory):\n        if not any(name == d or name.startswith(d + \"/\") for d in INPUT_DOMAINS):\n            continue\n        relative = PurePosixPath(name)\n        require(not relative.is_absolute() and \"..\" not in relative.parts, \"源路径越界\")\n        path, info = regular_file(root / relative)\n        require(path.resolve().is_relative_to(root), \"编译源真实路径越界\")\n        files[name] = {\"sha256\": sha256(path), \"bytes\": info.st_size,\n                       \"executable\": bool(info.st_mode & stat.S_IXUSR)}\n    return validate_source_manifest({\"domains\": list(INPUT_DOMAINS), \"files\": files,\n                                    \"source_manifest_sha256\": hashlib.sha256(canonical(files)).hexdigest()})\n\n\ndef build_argv(kind, build):\n    package, binaries, options, _ = BUILD_SPECS[kind][build]\n    argv = [\"cargo\", \"build\", \"--locked\", \"--release\", \"--message-format=json\", \"-p\", package]\n    for binary in binaries:\n        argv.extend([\"--bin\", binary])\n    return argv + list(options)\n\n\ndef validate_completion(reference):\n    \"\"\"核原启动、真实 wait、命令身份和原日志，不接受异常后碰巧 exit 0。\"\"\"\n    row = read_pinned_json(reference)\n    require(row[\"completion_receipt\"] == reference[\"path\"], \"completion 自身路径不符\")\n    require(\"runner_error\" not in row and row.get(\"exit_code\") == 0 and row.get(\"reaped\") is True\n            and row.get(\"signals\") == [], \"命令没有自然成功完成\")\n    launch_path, _ = regular_file(row[\"launch_receipt\"])\n    launch = strict_json(launch_path.read_text())\n    for key in (\"name\", \"argv\", \"cwd\", \"env\", \"removed_env_keys\", \"started_at\", \"started_monotonic_ns\",\n                \"timeout_seconds\", \"stdout\", \"stderr\", \"launch_receipt\", \"completion_receipt\", \"pid\", \"identity\"):\n        require(key in row and row[key] == launch.get(key), \"原 launch/completion 不一致：\" + key)\n    require(\"runner_error\" not in launch and launch.get(\"reaped\") is False\n            and launch.get(\"exit_code\") is None and launch.get(\"signals\") == [], \"原 launch 非启动状态\")\n    require(type(row[\"pid\"]) is int and row[\"pid\"] > 0 and row[\"identity\"][\"pid\"] == row[\"pid\"], \"PID 身份缺失\")\n    identity = row[\"identity\"]\n    require(type(identity.get(\"start_ticks\")) is int and identity[\"start_ticks\"] > 0\n            and re.fullmatch(r\"[0-9a-f-]{36}\", identity.get(\"boot_id\", \"\"))\n            and Path(identity.get(\"exe\", \"\")).is_absolute(), \"缺完整进程启动身份\")\n    require(type(row[\"started_monotonic_ns\"]) is int and type(row[\"ended_monotonic_ns\"]) is int\n            and row[\"ended_monotonic_ns\"] >= row[\"started_monotonic_ns\"], \"完成时序错误\")\n    for key in (\"stdout\", \"stderr\"):\n        path, info = regular_file(row[key])\n        require(info.st_size == row[key + \"_bytes\"] and sha256(path) == row[key + \"_sha256\"], \"原日志变化\")\n    return row\n\n\ndef validate_build_environment(env, toolchain=TOOLCHAIN):\n    \"\"\"rustc 与 Cargo 共用完整显式环境，不允许额外编译覆盖。\"\"\"\n    require(env.get(\"RUSTUP_TOOLCHAIN\") == toolchain and env.get(\"RUSTC_WRAPPER\") == \"\"\n            and env.get(\"CARGO_BUILD_JOBS\") == \"2\" and env.get(\"CARGO_TERM_COLOR\") == \"never\", \"构建环境不符\")\n    require(set(env) == {\"RUSTUP_TOOLCHAIN\", \"RUSTC_WRAPPER\", \"CARGO_BUILD_JOBS\", \"CARGO_TERM_COLOR\",\n                         \"CARGO_TARGET_DIR\", \"PATH\"}, \"构建环境清单有未批准覆盖\")\n    require(isinstance(env[\"PATH\"], str) and env[\"PATH\"], \"构建 PATH 缺失\")\n\n\ndef validate_cargo_build(reference, kind, build, *, allow_legacy=False):\n    row = validate_completion(reference)\n    require(row[\"argv\"] == build_argv(kind, build), \"Cargo 命令不属于批准 release 构建\")\n    env = row[\"env\"]\n    validate_build_environment(env, LEGACY_TOOLCHAIN if allow_legacy else TOOLCHAIN)\n    target_root = _absolute(env[\"CARGO_TARGET_DIR\"]).resolve(strict=True)\n    records = [strict_json(line) for line in Path(row[\"stdout\"]).read_text().splitlines() if line.strip()]\n    finished = [r for r in records if r.get(\"reason\") == \"build-finished\"]\n    require(len(finished) == 1 and finished[0].get(\"success\") is True, \"Cargo 未唯一自然完成\")\n    artifacts = [r for r in records if r.get(\"reason\") == \"compiler-artifact\"]\n    if kind == \"production\":\n        require(all(not f.startswith(\"test-\") for r in artifacts for f in r[\"features\"]), \"生产闭包泄漏 test-* feature\")\n    package, names, _, features = BUILD_SPECS[kind][build]\n    result = {}\n    for name in names:\n        matches = [r for r in artifacts if r.get(\"target\", {}).get(\"name\") == name\n                   and r[\"target\"].get(\"kind\") == [\"bin\"] and r.get(\"executable\")]\n        require(len(matches) == 1, \"Cargo executable 不唯一：\" + name)\n        item = matches[0]\n        package_id = item[\"package_id\"]\n        require(package_id.split(\"#\")[-1].split(\"@\")[0] == package or (\"/\" + package + \"#\") in package_id,\n                \"Cargo package 身份错误\")\n        require(sorted(item[\"features\"]) == sorted(features), \"实际 Cargo feature 闭包错误\")\n        profile = item[\"profile\"]\n        require(profile.get(\"opt_level\") == \"3\" and profile.get(\"test\") is False\n                and profile.get(\"debug_assertions\") is False and profile.get(\"overflow_checks\") is False\n                and profile.get(\"debuginfo\") in (None, 0), \"实际 Cargo profile 不是批准 release\")\n        executable = _absolute(item[\"executable\"])\n        require(executable.name == name and executable.parent.resolve() == target_root / \"release\",\n                \"Cargo executable 不在本次原生 release 目录\")\n        result[name] = item\n    return row, result\n\n\ndef elf_identity(path, expected_machine=183):\n    path, info = regular_file(path)\n    with path.open(\"rb\") as stream:\n        header = stream.read(64)\n    require(len(header) == 64 and header[:6] == b\"\\x7fELF\\x02\\x01\"\n            and int.from_bytes(header[18:20], \"little\") == expected_machine\n            and int.from_bytes(header[16:18], \"little\") in (2, 3), \"非批准架构的可执行 ELF\")\n    require(info.st_mode & stat.S_IXUSR, \"ELF 没有用户执行位\")\n    return {\"sha256\": sha256(path), \"bytes\": info.st_size, \"mode\": stat.S_IMODE(info.st_mode),\n            \"elf_machine\": expected_machine}\n\n\ndef parse_rustc_identity(version, expected_machine=183):\n    \"\"\"严格解析实际 -vV 的唯一字段；未知提交、非 nightly 和异架构均拒绝。\"\"\"\n    fields = {}\n    for line in version.splitlines():\n        if \": \" in line:\n            key, value = line.split(\": \", 1)\n            require(key not in fields, \"rustc -vV 字段重复：\" + key)\n            fields[key] = value\n    require(all(key in fields for key in (\"release\", \"commit-hash\", \"host\")), \"rustc -vV 必要字段缺失\")\n    require(re.fullmatch(r\"[0-9]+\\.[0-9]+\\.[0-9]+-nightly\", fields[\"release\"]), \"实际 rustc 不是 nightly\")\n    require(re.fullmatch(r\"[0-9a-f]{40}\", fields[\"commit-hash\"]), \"实际 rustc 提交未知或非法\")\n    hosts = {183: \"aarch64-unknown-linux-gnu\", 62: \"x86_64-unknown-linux-gnu\"}\n    require(expected_machine in hosts and fields[\"host\"] == hosts[expected_machine], \"实际 rustc host 与 ELF 架构不符\")\n    return {\"release\": fields[\"release\"], \"commit_hash\": fields[\"commit-hash\"], \"host\": fields[\"host\"]}\n\n\ndef validate_toolchain_window(manifest, expected_machine):\n    \"\"\"验证准备驱动已固定的前后身份与时间窗；本函数不更新工具链或联网。\"\"\"\n    require(manifest.get(\"toolchain\") == TOOLCHAIN, \"V2 只接受浮动 nightly 准备合同\")\n    before, after = [validate_completion(manifest[key]) for key in (\"rustc_before\", \"rustc_after\")]\n    for row in (before, after):\n        require(row[\"argv\"] == [\"rustc\", \"-vV\"], \"缺实际 rustc -vV 工具链回执\")\n        validate_build_environment(row[\"env\"])\n        require(row[\"cwd\"] == manifest[\"build_root\"], \"rustc 与构建根目录不一致\")\n        identity = parse_rustc_identity(Path(row[\"stdout\"]).read_text(), expected_machine)\n        require(identity == manifest.get(\"rustc_identity\"), \"前后实际 rustc 身份与清单不符\")\n    require(before[\"env\"] == after[\"env\"], \"前后 rustc 环境变化\")\n    require(before[\"identity\"][\"boot_id\"] == after[\"identity\"][\"boot_id\"], \"前后 rustc 跨 boot\")\n    require(before[\"ended_monotonic_ns\"] <= after[\"started_monotonic_ns\"], \"rustc 前后时间窗倒序\")\n    return before, after\n\n\ndef validate_artifact_set(manifest, *, source_manifest, expected_kind, expected_head,\n                          expected_machine=183, build_ancestor_verified=False, allow_legacy=False):\n    legacy = manifest.get(\"schema\") == \"P7_RELEASE_ARTIFACTS_V1\"\n    require((manifest.get(\"schema\") == \"P7_RELEASE_ARTIFACTS_V2\" or (legacy and allow_legacy is True))\n            and manifest.get(\"kind\") == expected_kind,\n            \"产物集合类型错误\")\n    require(expected_kind in BUILD_SPECS and manifest.get(\"deployable\") is False, \"产物不得宣称可部署\")\n    require(re.fullmatch(r\"[0-9a-f]{40}\", expected_head) and re.fullmatch(r\"[0-9a-f]{40}\", manifest[\"build_head\"]),\n            \"Git HEAD 格式错误\")\n    inherited = manifest[\"build_head\"] != expected_head\n    require(not inherited or build_ancestor_verified is True, \"不同 build HEAD 缺调用者祖先验证\")\n    validate_source_manifest(source_manifest)\n    require(read_pinned_json(manifest[\"source_manifest\"]) == source_manifest, \"完整编译输入变化，不能继承产物\")\n    require(manifest[\"source_manifest_sha256\"] == source_manifest[\"source_manifest_sha256\"], \"源摘要不符\")\n    require(manifest[\"machine\"] == expected_machine, \"产物架构不符\")\n    if legacy:\n        require(manifest[\"toolchain\"] == LEGACY_TOOLCHAIN and manifest[\"rustc_commit\"] == LEGACY_RUSTC_COMMIT,\n                \"历史工具链不符\")\n        rustc = validate_completion(manifest[\"rustc_receipt\"])\n        require(rustc[\"argv\"] == [\"rustc\", \"-vV\"] and rustc[\"env\"].get(\"RUSTUP_TOOLCHAIN\") == LEGACY_TOOLCHAIN,\n                \"缺历史 rustc 工具链回执\")\n        version = Path(rustc[\"stdout\"]).read_text()\n        host = \"aarch64-unknown-linux-gnu\" if expected_machine == 183 else \"x86_64-unknown-linux-gnu\"\n        require(\"commit-hash: \" + LEGACY_RUSTC_COMMIT + \"\\n\" in version and \"host: \" + host + \"\\n\" in version,\n                \"历史 rustc 身份不符\")\n    else:\n        before, after = validate_toolchain_window(manifest, expected_machine)\n    specs = BUILD_SPECS[expected_kind]\n    require(set(manifest[\"builds\"]) == set(specs), \"构建回执集合不完整\")\n    expected_names = {name for spec in specs.values() for name in spec[1]}\n    require(set(manifest[\"artifacts\"]) == expected_names, \"产物集合不完整\")\n    frozen_paths = set()\n    for build, reference in manifest[\"builds\"].items():\n        row, artifacts = validate_cargo_build(reference, expected_kind, build, allow_legacy=legacy)\n        require(row[\"cwd\"] == manifest[\"build_root\"], \"构建根目录不一致\")\n        if not legacy:\n            require(row[\"env\"] == before[\"env\"] and row[\"identity\"][\"boot_id\"] == before[\"identity\"][\"boot_id\"],\n                    \"Cargo 与 rustc 环境或 boot 不同\")\n            require(before[\"ended_monotonic_ns\"] <= row[\"started_monotonic_ns\"]\n                    <= row[\"ended_monotonic_ns\"] <= after[\"started_monotonic_ns\"], \"Cargo 不在 rustc 前后身份时间窗内\")\n        for name, actual in artifacts.items():\n            item = manifest[\"artifacts\"][name]\n            require(item[\"build\"] == build and item[\"compiler_artifact\"] == actual\n                    and item[\"cargo_path\"] == actual[\"executable\"], \"ELF 与 Cargo 原记录不对应\")\n            require(item[\"features\"] == actual[\"features\"] and item[\"profile\"] == \"release\"\n                    and item[\"command\"] == row[\"argv\"] and item[\"exit_code\"] == 0\n                    and item[\"build_head\"] == manifest[\"build_head\"]\n                    and item[\"source_manifest_sha256\"] == manifest[\"source_manifest_sha256\"], \"sidecar 构建身份不符\")\n            frozen = _absolute(item[\"path\"])\n            require(frozen.parent == _absolute(manifest[\"artifact_directory\"]) and frozen.name == name,\n                    \"冻结 ELF 目录或名称错误\")\n            require(item[\"sidecar\"][\"path\"] == str(frozen) + \".build.json\", \"sidecar 文件名错误\")\n            require(frozen.resolve() != Path(item[\"cargo_path\"]).resolve(), \"冻结 ELF 仍指向 Cargo 可变输出\")\n            require(frozen.resolve() not in frozen_paths, \"冻结 ELF 路径复用\")\n            frozen_paths.add(frozen.resolve())\n            require(frozen.stat().st_nlink == 1, \"冻结 ELF 仍有硬链接\")\n            identity = elf_identity(frozen, expected_machine)\n            require(all(item[key] == value for key, value in identity.items()), \"冻结 ELF 身份变化\")\n            require(read_pinned_json(item[\"sidecar\"]) == {k: v for k, v in item.items() if k != \"sidecar\"},\n                    \"ELF sidecar 不符\")\n    return {\"valid\": True, \"actual_build_head\": manifest[\"build_head\"], \"runtime_head\": expected_head,\n            \"inherited_from_ancestor\": inherited, \"kind\": expected_kind,\n            \"artifacts\": {name: row[\"path\"] for name, row in manifest[\"artifacts\"].items()}}\n\n\n# systemd 的依赖关系是集合；只规范化这些字段的显示顺序，重复仍保留。\nUNIT_DEPENDENCY_PROPERTIES = frozenset({\n    \"Requires\", \"Wants\", \"After\", \"Before\", \"BindsTo\", \"PartOf\", \"Conflicts\",\n})\n\nUNIT_PROPERTIES = (\n    \"Id\", \"LoadState\", \"ActiveState\", \"SubState\", \"MainPID\", \"UnitFileState\", \"FragmentPath\", \"DropInPaths\",\n    \"User\", \"Group\", \"WorkingDirectory\", \"After\", \"Before\", \"Requires\", \"Wants\", \"BindsTo\", \"PartOf\",\n    \"Conflicts\", \"Restart\", \"RemainAfterExit\", \"LimitRTPRIO\", \"LimitRTPRIOSoft\", \"LimitMEMLOCK\",\n    \"LimitMEMLOCKSoft\", \"CPUAffinity\", \"Nice\", \"CPUSchedulingPolicy\", \"CPUSchedulingPriority\",\n    \"ExecStart\", \"ExecStop\", \"Environment\", \"EnvironmentFiles\",\n)\n\n\n# 主驱动仍使用项目 Python；这个 Linux 属性探针复用系统已有的 python3-dbus。\n# 缺绑定或 D-Bus 查询失败一律拒绝，不安装依赖，不调用 StartUnit/RefUnit。\nSYSTEMD_EMPTY_PROPERTY_PROBE = r'''\nimport dbus\nimport json\nimport sys\n\nunit = sys.argv[1]\nnames = json.loads(sys.argv[2])\nbus = dbus.SystemBus(private=True)\ntry:\n    manager = dbus.Interface(bus.get_object(\"org.freedesktop.systemd1\", \"/org/freedesktop/systemd1\"),\n                             \"org.freedesktop.systemd1.Manager\")\n    path = manager.LoadUnit(unit)\n    properties = dbus.Interface(bus.get_object(\"org.freedesktop.systemd1\", path),\n                                \"org.freedesktop.DBus.Properties\")\n    result = {\"unit\": str(properties.Get(\"org.freedesktop.systemd1.Unit\", \"Id\")),\n              \"object_path\": str(path), \"load_state\": str(properties.Get(\"org.freedesktop.systemd1.Unit\", \"LoadState\")),\n              \"python\": sys.version, \"dbus_file\": dbus.__file__, \"properties\": {}}\n    for name in names:\n        value = properties.Get(\"org.freedesktop.systemd1.Service\", name)\n        result[\"properties\"][name] = {\"array\": isinstance(value, dbus.Array),\n                                      \"element_signature\": str(getattr(value, \"signature\", \"\")),\n                                      \"count\": len(value)}\nfinally:\n    bus.close()\nresult[\"connection_closed\"] = True\nprint(json.dumps(result))\n'''\n\nSYSTEMD_EMPTY_PROPERTY_SIGNATURES = {\"ExecStop\": \"(sasbttttuii)\", \"EnvironmentFiles\": \"(sb)\"}\n\n\ndef confirm_empty_systemd_properties(unit, names):\n    \"\"\"只对 show 省略的两个复杂属性，以同一 D-Bus 连接核实际 typed 空数组。\"\"\"\n    require(unit in (*BUSINESS_UNITS, HANDOFF_UNIT) and names\n            and set(names) <= set(SYSTEMD_EMPTY_PROPERTY_SIGNATURES), \"未批准的空属性查询\")\n    result = subprocess.run([\"/usr/bin/python3\", \"-c\", SYSTEMD_EMPTY_PROPERTY_PROBE,\n                             unit, json.dumps(sorted(names))],\n                            capture_output=True, text=True, timeout=20, check=False)\n    require(result.returncode == 0, \"systemd typed 属性查询失败：\" + unit)\n    proof = strict_json(result.stdout)\n    require(proof.get(\"unit\") == unit and proof.get(\"load_state\") == \"loaded\"\n            and proof.get(\"connection_closed\") is True\n            and re.fullmatch(r\"/org/freedesktop/systemd1/unit/[A-Za-z0-9_]+\", proof.get(\"object_path\", \"\"))\n            and set(proof.get(\"properties\", {})) == set(names), \"systemd typed 属性来源或集合错误\")\n    for name in names:\n        value = proof[\"properties\"][name]\n        require(value.get(\"array\") is True\n                and value.get(\"element_signature\") == SYSTEMD_EMPTY_PROPERTY_SIGNATURES[name]\n                and type(value.get(\"count\")) is int and value[\"count\"] == 0,\n                \"systemd 属性未被证明是准确签名的空数组：\" + name)\n    return proof\n\n\ndef read_systemd_unit(unit):\n    require(unit in (*BUSINESS_UNITS, HANDOFF_UNIT), \"未批准读取的 unit\")\n    result = subprocess.run([\"systemctl\", \"show\", unit, \"--property=\" + \",\".join(UNIT_PROPERTIES)],\n                            capture_output=True, text=True, timeout=20, check=False)\n    require(result.returncode == 0, \"systemctl 只读查询失败：\" + unit)\n    fields = dict(line.split(\"=\", 1) for line in result.stdout.splitlines() if \"=\" in line)\n    missing = set(UNIT_PROPERTIES) - set(fields)\n    require(set(fields) <= set(UNIT_PROPERTIES) and missing <= set(SYSTEMD_EMPTY_PROPERTY_SIGNATURES),\n            \"unit 属性缺失或有额外字段\")\n    if missing:\n        confirm_empty_systemd_properties(unit, missing)\n        fields.update({name: \"\" for name in missing})\n    require(set(fields) == set(UNIT_PROPERTIES), \"unit 属性缺失\")\n    for key in (\"ExecStart\", \"ExecStop\", \"Environment\", \"EnvironmentFiles\"):\n        raw = fields[key]\n        safe = {\"full_value_sha256\": hashlib.sha256(raw.encode()).hexdigest()}\n        if key == \"Environment\":\n            safe[\"names\"] = sorted(item.split(\"=\", 1)[0] for item in shlex.split(raw) if \"=\" in item)\n        if key == \"EnvironmentFiles\":\n            safe[\"paths\"] = re.findall(r\"(/[^ ;()]+)\", raw)\n        fields[key] = safe\n    for key in UNIT_DEPENDENCY_PROPERTIES:\n        fields[key] = \" \".join(sorted(fields[key].split()))\n    return fields\n\n\ndef installed_file_identity(path):\n    path = _absolute(path)\n    original = path.lstat()\n    resolved = path.resolve(strict=True)\n    # marker 从来不属于本接口的批准输入，拒绝误传。\n    require(not resolved.is_relative_to(\"/var/lib/robot\"), \"禁止读取机器人运行态 marker\")\n    real = resolved.stat()\n    require(stat.S_ISREG(real.st_mode), \"安装快照只允许普通文件\")\n    return {\"path\": str(path), \"resolved\": str(resolved), \"exists\": True,\n            \"link_target\": os.readlink(path) if stat.S_ISLNK(original.st_mode) else None,\n            \"mode\": stat.S_IMODE(real.st_mode), \"uid\": real.st_uid, \"gid\": real.st_gid,\n            \"bytes\": real.st_size, \"device\": real.st_dev, \"inode\": real.st_ino, \"sha256\": sha256(resolved)}\n\n\ndef snapshot_installed(reference, *, unit_reader=read_systemd_unit):\n    \"\"\"只读刷新明确清单及七个 unit；不读取环境值、marker 或串口。\"\"\"\n    required = {\"installed:\" + name for name in INSTALLED_NAMES} | {\"config:left\", \"config:right\", \"config:roles\"}\n    require(required <= set(reference[\"files\"]), \"安装参考清单缺四件/三配置\")\n    files = {name: installed_file_identity(item[\"path\"]) for name, item in sorted(reference[\"files\"].items())}\n    units = {name: unit_reader(name) for name in (*BUSINESS_UNITS, HANDOFF_UNIT)}\n    # 新增 drop-in 或 EnvironmentFile 必须进入真实快照，不可只读旧路径漏掉漂移。\n    covered = {row[\"path\"] for row in files.values()}\n    for row in units.values():\n        paths = [row[\"FragmentPath\"], *shlex.split(row[\"DropInPaths\"]), *row[\"EnvironmentFiles\"][\"paths\"]]\n        for path in paths:\n            if path and path not in covered:\n                files[\"discovered:\" + path] = installed_file_identity(path)\n                covered.add(path)\n    return {\"schema\": \"P7_INSTALLED_STATE_V1\", \"host\": os.uname().nodename,\n            \"boot_id\": Path(\"/proc/sys/kernel/random/boot_id\").read_text().strip(), \"files\": files, \"units\": units}\n\n\ndef validate_installed_snapshot(actual, expected):\n    require(actual.get(\"schema\") == expected.get(\"schema\") == \"P7_INSTALLED_STATE_V1\", \"安装状态 schema 错误\")\n    required = {\"installed:\" + name for name in INSTALLED_NAMES} | {\"config:left\", \"config:right\", \"config:roles\"}\n    require(required <= set(actual.get(\"files\", {})) and actual.get(\"host\") and actual.get(\"boot_id\"),\n            \"安装身份缺四件、三配置或主机身份\")\n    require(actual == expected, \"安装文件、配置、unit、主机或启动身份变化\")\n    require(set(actual[\"units\"]) == {*BUSINESS_UNITS, HANDOFF_UNIT}, \"七个 unit 不完整\")\n    for name in BUSINESS_UNITS:\n        row = actual[\"units\"][name]\n        require(row[\"LoadState\"] == \"loaded\" and row[\"ActiveState\"] == \"inactive\"\n                and row[\"SubState\"] == \"dead\" and row[\"MainPID\"] == \"0\", \"业务服务没有完全停止：\" + name)\n    require(actual[\"units\"][HANDOFF_UNIT][\"LoadState\"] == \"loaded\", \"handoff unit 丢失\")\n    return {\"valid\": True, \"installed_unchanged\": True, \"six_services_inactive\": True}\n\n\ndef validate_target_isolation(target_root, installed):\n    \"\"\"Cargo 前核目录、所有可能输出及硬链接；不创建目录、不修改安装件。\"\"\"\n    root = _absolute(target_root).resolve(strict=True)\n    require(root.is_dir(), \"必须复用已存在的独立 Cargo 缓存\")\n    require(set(installed) == set(INSTALLED_NAMES), \"隔离校验必须包含实际安装四件\")\n    identities = [installed_file_identity(path) for path in installed.values()]\n    protected_paths = {Path(row[\"resolved\"]) for row in identities}\n    protected_inodes = {(row[\"device\"], row[\"inode\"]) for row in identities}\n    require(all(not path.is_relative_to(root) for path in protected_paths), \"Cargo target 包含现役安装件\")\n    # 目录中任意现存普通文件都不能硬链接安装件，包括 deps 中的 Cargo 别名。\n    for directory, dirs, files in os.walk(root, followlinks=False):\n        require(all(not (Path(directory) / name).is_symlink() for name in dirs), \"Cargo 缓存含链接目录\")\n        for name in files:\n            path = Path(directory) / name\n            resolved = path.resolve(strict=True)\n            require(resolved not in protected_paths, \"Cargo 输出链接到安装件\")\n            info = path.stat()\n            require((info.st_dev, info.st_ino) not in protected_inodes, \"Cargo 输出硬链接到安装件\")\n    return {\"valid\": True, \"target_root\": str(root), \"installed\": identities}\n\n\ndef fixed_build_environment(target_root, inherited=None):\n    \"\"\"清除构建与测试覆盖，只公开明确设置的变量；保留缓存和凭据。\"\"\"\n    env = dict(os.environ if inherited is None else inherited)\n    fixed = {\"RUSTFLAGS\", \"CARGO_ENCODED_RUSTFLAGS\", \"RUSTDOCFLAGS\", \"RUSTC\", \"RUSTDOC\",\n             \"RUSTC_WRAPPER\", \"RUSTC_WORKSPACE_WRAPPER\", \"RUST_TEST_THREADS\", \"CLIPPY_ARGS\",\n             \"CARGO_INCREMENTAL\", \"NOTIFY_SOCKET\", \"INVOCATION_ID\", \"WATCHDOG_USEC\", \"WATCHDOG_PID\"}\n    removed = []\n    for key in list(env):\n        if key in fixed or key.startswith((\"CARGO_PROFILE_\", \"CARGO_TARGET_\", \"CARGO_BUILD_\", \"ROBOT_TEST_\")):\n            removed.append(key)\n            del env[key]\n    env.update(RUSTUP_TOOLCHAIN=TOOLCHAIN, RUSTC_WRAPPER=\"\", CARGO_TERM_COLOR=\"never\",\n               CARGO_TARGET_DIR=str(_absolute(target_root).resolve(strict=True)), CARGO_BUILD_JOBS=\"2\")\n    shown = {key: env[key] for key in (\"RUSTUP_TOOLCHAIN\", \"RUSTC_WRAPPER\", \"CARGO_TERM_COLOR\",\n                                      \"CARGO_TARGET_DIR\", \"CARGO_BUILD_JOBS\", \"PATH\")}\n    return env, shown, sorted(removed)\n", "stderr": "", "stdout_sha256": "bd2b3f7bb8527cd9ecec73894171638e9cf378656b89e284a585c3baa37b8731", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 28863, "stderr_bytes": 0}, {"argv": ["git", "-C", "/home/loosqk/repo/robot/robot-system", "rev-parse", "HEAD"], "started_ns": 1791623451911974295, "started_monotonic_ns": 3376701372720606, "pid": 624677, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623451914505609, "elapsed_ns": 2529426, "child_end_class": "EXIT_STATUS", "stdout": "ca14f0e6cf6df8ecc6baaaa8dff2dddb64abbd0a\n", "stderr": "", "stdout_sha256": "c4dc0b684e4d21e328ff289b7543b555cc30afa2d1c72b7e2a02ca9e44bb52df", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 41, "stderr_bytes": 0}, {"argv": ["git", "-C", "/home/loosqk/repo/robot/robot-system", "status", "--porcelain=v1", "--untracked-files=all"], "started_ns": 1791623451914648907, "started_monotonic_ns": 3376701375395218, "pid": 624678, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623451922831501, "elapsed_ns": 8180034, "child_end_class": "EXIT_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["systemctl", "show", "xlerobot-gateway-left.service", "xlerobot-gateway-right.service", "xlerobot-s1-left.service", "xlerobot-s1-right.service", "xlerobot-s0-left-arm.service", "xlerobot-s0-right-arm.service", "--property=Id,LoadState,ActiveState,SubState,MainPID"], "started_ns": 1791623451952283121, "started_monotonic_ns": 3376701413029496, "pid": 624679, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623452011817031, "elapsed_ns": 59529878, "child_end_class": "EXIT_STATUS", "stdout": "MainPID=0\nId=xlerobot-gateway-left.service\nLoadState=loaded\nActiveState=inactive\nSubState=dead\n\nMainPID=0\nId=xlerobot-gateway-right.service\nLoadState=loaded\nActiveState=inactive\nSubState=dead\n\nMainPID=0\nId=xlerobot-s1-left.service\nLoadState=loaded\nActiveState=inactive\nSubState=dead\n\nMainPID=0\nId=xlerobot-s1-right.service\nLoadState=loaded\nActiveState=inactive\nSubState=dead\n\nMainPID=0\nId=xlerobot-s0-left-arm.service\nLoadState=loaded\nActiveState=inactive\nSubState=dead\n\nMainPID=0\nId=xlerobot-s0-right-arm.service\nLoadState=loaded\nActiveState=inactive\nSubState=dead\n", "stderr": "", "stdout_sha256": "d4fadd800f085252763bc0fffdd1f3e623c8662f23549743a4fb5efdb757e126", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 566, "stderr_bytes": 0}, {"argv": ["udevadm", "info", "--query=property", "--name", "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5A7C121427-if00"], "started_ns": 1791623452012182478, "started_monotonic_ns": 3376701472928789, "pid": 624680, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623452015575089, "elapsed_ns": 3390403, "child_end_class": "EXIT_STATUS", "stdout": "DEVPATH=/devices/platform/bus@0/3610000.usb/usb1/1-2/1-2.4/1-2.4.3/1-2.4.3:1.0/tty/ttyACM0\nDEVNAME=/dev/ttyACM0\nMAJOR=166\nMINOR=0\nSUBSYSTEM=tty\nUSEC_INITIALIZED=3368981464912\nID_VENDOR=1a86\nID_VENDOR_ENC=1a86\nID_VENDOR_ID=1a86\nID_MODEL=USB_Single_Serial\nID_MODEL_ENC=USB\\x20Single\\x20Serial\nID_MODEL_ID=55d3\nID_REVISION=0445\nID_SERIAL=1a86_USB_Single_Serial_5A7C121427\nID_SERIAL_SHORT=5A7C121427\nID_TYPE=generic\nID_BUS=usb\nID_USB_INTERFACES=:020201:0a0000:\nID_USB_INTERFACE_NUM=00\nID_USB_DRIVER=cdc_acm\nID_USB_CLASS_FROM_DATABASE=Communications\nID_VENDOR_FROM_DATABASE=QinHeng Electronics\nID_PATH=platform-3610000.usb-usb-0:2.4.3:1.0\nID_PATH_TAG=platform-3610000_usb-usb-0_2_4_3_1_0\nID_MM_CANDIDATE=1\nDEVLINKS=/dev/serial/by-path/platform-3610000.usb-usb-0:2.4.3:1.0 /dev/serial/by-id/usb-1a86_USB_Single_Serial_5A7C121427-if00\nTAGS=:systemd:\nCURRENT_TAGS=:systemd:\n", "stderr": "", "stdout_sha256": "d7b002ec56db4fa0d0a4cc7ffe741d59ac5bdf8b96526103e4d18531340be283", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 866, "stderr_bytes": 0}, {"argv": ["udevadm", "info", "--query=property", "--name", "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5A7C122340-if00"], "started_ns": 1791623452015955576, "started_monotonic_ns": 3376701476701823, "pid": 624681, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623452018792112, "elapsed_ns": 2835032, "child_end_class": "EXIT_STATUS", "stdout": "DEVPATH=/devices/platform/bus@0/3610000.usb/usb1/1-2/1-2.4/1-2.4.4/1-2.4.4:1.0/tty/ttyACM1\nDEVNAME=/dev/ttyACM1\nMAJOR=166\nMINOR=1\nSUBSYSTEM=tty\nUSEC_INITIALIZED=3359632006336\nID_VENDOR=1a86\nID_VENDOR_ENC=1a86\nID_VENDOR_ID=1a86\nID_MODEL=USB_Single_Serial\nID_MODEL_ENC=USB\\x20Single\\x20Serial\nID_MODEL_ID=55d3\nID_REVISION=0445\nID_SERIAL=1a86_USB_Single_Serial_5A7C122340\nID_SERIAL_SHORT=5A7C122340\nID_TYPE=generic\nID_BUS=usb\nID_USB_INTERFACES=:020201:0a0000:\nID_USB_INTERFACE_NUM=00\nID_USB_DRIVER=cdc_acm\nID_USB_CLASS_FROM_DATABASE=Communications\nID_VENDOR_FROM_DATABASE=QinHeng Electronics\nID_PATH=platform-3610000.usb-usb-0:2.4.4:1.0\nID_PATH_TAG=platform-3610000_usb-usb-0_2_4_4_1_0\nID_MM_CANDIDATE=1\nDEVLINKS=/dev/serial/by-path/platform-3610000.usb-usb-0:2.4.4:1.0 /dev/serial/by-id/usb-1a86_USB_Single_Serial_5A7C122340-if00\nTAGS=:systemd:\nCURRENT_TAGS=:systemd:\n", "stderr": "", "stdout_sha256": "65a76a55d88f03c258676b2f759025abd2e53af3b7ea11476aa2c0996dfb178b", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 866, "stderr_bytes": 0}, {"argv": ["fuser", "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5A7C121427-if00"], "started_ns": 1791623452019159032, "started_monotonic_ns": 3376701479905343, "pid": 624682, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 1, "exit_code": 1, "finished_ns": 1791623452030969504, "elapsed_ns": 11808520, "child_end_class": "EXIT_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["sudo", "-n", "fuser", "/dev/serial/by-id/usb-1a86_USB_Single_Serial_5A7C121427-if00"], "started_ns": 17916
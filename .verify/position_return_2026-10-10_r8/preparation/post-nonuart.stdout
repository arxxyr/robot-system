T_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["fuser", "/var/lib/robot/xlerobot_right/rx_trust.lock"], "started_ns": 1791623452284551562, "started_monotonic_ns": 3376701745297873, "pid": 624694, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 1, "exit_code": 1, "finished_ns": 1791623452295722439, "elapsed_ns": 11169149, "child_end_class": "EXIT_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["sudo", "-n", "fuser", "/var/lib/robot/xlerobot_right/rx_trust.lock"], "started_ns": 1791623452295882794, "started_monotonic_ns": 3376701756629105, "pid": 624695, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 1, "exit_code": 1, "finished_ns": 1791623452349879059, "elapsed_ns": 53991433, "child_end_class": "EXIT_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["fuser", "/var/lib/robot/xlerobot_right/estop_latch.lock"], "started_ns": 1791623452350147224, "started_monotonic_ns": 3376701810893503, "pid": 624697, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 1, "exit_code": 1, "finished_ns": 1791623452361301044, "elapsed_ns": 11151676, "child_end_class": "EXIT_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["sudo", "-n", "fuser", "/var/lib/robot/xlerobot_right/estop_latch.lock"], "started_ns": 1791623452361458327, "started_monotonic_ns": 3376701822204638, "pid": 624698, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 1, "exit_code": 1, "finished_ns": 1791623452415951466, "elapsed_ns": 54488275, "child_end_class": "EXIT_STATUS", "stdout": "", "stderr": "", "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stderr_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "stdout_bytes": 0, "stderr_bytes": 0}, {"argv": ["sudo", "-n", "/usr/bin/python3", "-I", "-S", "-c", "\nimport json\nimport os\nimport sys\n\ndef _read_at(directory, name, limit):\n    descriptor = os.open(name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=directory)\n    try:\n        data = bytearray()\n        while len(data) <= limit:\n            part = os.read(descriptor, min(8192, limit + 1 - len(data)))\n            if not part:\n                return bytes(data)\n            data.extend(part)\n        raise ValueError(\"proc字段超过读取上限\")\n    finally:\n        os.close(descriptor)\n\ndef _stat_at(directory, pid):\n    raw = _read_at(directory, \"stat\", 8192).decode()\n    opening, closing = raw.find(\"(\"), raw.rfind(\")\")\n    if opening < 1 or closing <= opening or int(raw[:opening].strip()) != pid:\n        raise ValueError(\"proc stat PID格式错误\")\n    fields = raw[closing + 2:].split()\n    start = int(fields[19])\n    if start < 0:\n        raise ValueError(\"proc start_ticks不能为负\")\n    return {\"pid\": pid, \"start_ticks\": start, \"pgid\": int(fields[2]), \"state\": fields[0]}\n\ndef _uids_at(directory):\n    rows = [line.split()[1:] for line in _read_at(directory, \"status\", 65536).decode().splitlines()\n            if line.startswith(\"Uid:\")]\n    if len(rows) != 1 or len(rows[0]) != 4:\n        raise ValueError(\"proc Uid字段不完整\")\n    values = [int(value) for value in rows[0]]\n    if any(value < 0 for value in values):\n        raise ValueError(\"proc Uid无效\")\n    return values\n\ndef _boot(root):\n    with open(root + \"/sys/kernel/random/boot_id\", encoding=\"ascii\") as stream:\n        value = stream.read(128).strip()\n    if len(value) != 36 or any(c not in \"0123456789abcdef-\" for c in value):\n        raise ValueError(\"proc boot_id格式错误\")\n    return value\n\ndef _stable(left, right):\n    return all(left[key] == right[key] for key in (\"pid\", \"start_ticks\", \"boot_id\", \"pgid\", \"uids\"))\n\ndef _proc_probe(pid, expected=None, details=True, root=\"/proc\"):\n    result = {\"pid\": pid}\n    directory = None\n    try:\n        directory = os.open(root + \"/\" + str(pid), os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)\n        before = _stat_at(directory, pid)\n        before.update(boot_id=_boot(root), uids=_uids_at(directory))\n        result[\"before\"] = before\n        if expected is not None and not _stable(before, expected):\n            return dict(result, status=\"replaced\")\n        identity = dict(before)\n        if details:\n            identity[\"argv\"] = _read_at(directory, \"cmdline\", 65536).rstrip(b\"\\0\").decode().split(\"\\0\")\n            identity[\"exe\"] = None if before[\"state\"] == \"Z\" else os.readlink(\"exe\", dir_fd=directory)\n            identity[\"zombie\"] = before[\"state\"] == \"Z\"\n        after = _stat_at(directory, pid)\n        after.update(boot_id=_boot(root), uids=_uids_at(directory))\n        result[\"after\"] = after\n        if not _stable(before, after):\n            return dict(result, status=\"replaced\")\n        return dict(result, status=\"observed\", identity=identity)\n    except FileNotFoundError as error:\n        result.update(error_errno=error.errno, error_filename=error.filename)\n        # exe缺失不等于PID退出；只在同一dirfd的stat也消失时报告vanished。\n        if directory is not None:\n            try:\n                result[\"remaining_stat\"] = _stat_at(directory, pid)\n            except FileNotFoundError:\n                return dict(result, status=\"vanished\", error=repr(error))\n            except Exception as recheck_error:\n                return dict(result, status=\"unreadable\", error=repr(recheck_error))\n            return dict(result, status=\"unreadable\", error=repr(error))\n        return dict(result, status=\"vanished\", error=repr(error))\n    except PermissionError as error:\n        return dict(result, status=\"permission\", error=repr(error))\n    except (OSError, ValueError, KeyError, IndexError, UnicodeError) as error:\n        return dict(result, status=\"unreadable\", error=repr(error))\n    finally:\n        if directory is not None:\n            os.close(directory)\n\ndef _probe_main():\n    text = sys.stdin.read(131073)\n    if len(text) > 131072:\n        raise ValueError(\"PID批次输入过大\")\n    request = json.loads(text)\n    if set(request) != {\"schema\", \"candidates\"} or request[\"schema\"] != \"P7_PROC_PROBE_V1\":\n        raise ValueError(\"PID探针请求格式错误\")\n    candidates = request[\"candidates\"]\n    if not isinstance(candidates, list) or not 1 <= len(candidates) <= 256:\n        raise ValueError(\"PID批次超限\")\n    pids = set()\n    for expected in candidates:\n        if set(expected) != {\"pid\", \"start_ticks\", \"boot_id\", \"pgid\", \"state\", \"uids\"}:\n            raise ValueError(\"PID身份字段错误\")\n        pid = expected[\"pid\"]\n        if type(pid) is not int or pid <= 0 or pid in pids:\n            raise ValueError(\"PID无效或重复\")\n        if type(expected[\"start_ticks\"]) is not int or expected[\"start_ticks\"] < 0:\n            raise ValueError(\"start_ticks无效\")\n        if type(expected[\"pgid\"]) is not int or expected[\"pgid\"] < 0:\n            raise ValueError(\"PGID无效\")\n        if not isinstance(expected[\"uids\"], list) or len(expected[\"uids\"]) != 4 or any(type(u) is not int or u < 0 for u in expected[\"uids\"]):\n            raise ValueError(\"Uid无效\")\n        if not isinstance(expected[\"state\"], str) or len(expected[\"state\"]) != 1 or not isinstance(expected[\"boot_id\"], str):\n            raise ValueError(\"PID状态/boot错误\")\n        pids.add(pid)\n    print(json.dumps({\"schema\": \"P7_PROC_PROBE_V1\", \"reader_euid\": os.geteuid(), \"boot_id\": _boot(\"/proc\"),\n                      \"rows\": [_proc_probe(row[\"pid\"], row) for row in candidates]}, ensure_ascii=False))\n\nif __name__ == \"__main__\":\n    _probe_main()\n"], "started_ns": 1791623452487344587, "started_monotonic_ns": 3376701948090898, "pid": 624700, "reaped": true, "signals_sent": [], "cleanup": false, "communicate_errors": [], "wait_returncode": 0, "exit_code": 0, "finished_ns": 1791623452529120963, "elapsed_ns": 41771448, "child_end_class": "EXIT_STATUS", "stdout": "{\"schema\": \"P7_PROC_PROBE_V1\", \"reader_euid\": 0, \"boot_id\": \"6cf7ee3e-a3c5-4c91-80bc-4ca924818b53\", \"rows\": [{\"pid\": 529651, \"before\": {\"pid\": 529651, \"start_ticks\": 327631353, \"pgid\": 529650, \"state\": \"S\", \"boot_id\": \"6cf7ee3e-a3c5-4c91-80bc-4ca924818b53\", \"uids\": [1000, 1000, 1000, 1000]}, \"after\": {\"pid\": 529651, \"start_ticks\": 327631353, \"pgid\": 529650, \"state\": \"S\", \"boot_id\": \"6cf7ee3e-a3c5-4c91-80bc-4ca924818b53\", \"uids\": [1000, 1000, 1000, 1000]}, \"status\": \"observed\", \"identity\": {\"pid\": 529651, \"start_ticks\": 327631353, \"pgid\": 529650, \"state\": \"S\", \"boot_id\": \"6cf7ee3e-a3c5-4c91-80bc-4ca924818b53\", \"uids\": [1000, 1000, 1000, 1000], \"argv\": [\"(sd-pam)\"], \"exe\": \"/usr/lib/systemd/systemd\", \"zombie\": false}}, {\"pid\": 624665, \"before\": {\"pid\": 624665, \"start_ticks\": 337670028, \"pgid\": 624636, \"state\": \"S\", \"boot_id\": \"6cf7ee3e-a3c5-4c91-80bc-4ca924818b53\", \"uids\": [1000, 1000, 1000, 1000]}, \"after\": {\"pid\": 624665, \"start_ticks\": 337670028, \"pgid\": 624636, \"state\": \"S\",
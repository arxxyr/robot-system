# XLeRobot S1 coordinator —— left 臂（v0.5 候选 E；Spec D12 + D2 身份表）。
#
# 依赖图（r5 V4 锁定）：`Requires=` + `After=` **同臂 S0** ——S1 启动期要读一
# 次 `/xlerobot_left/s0/left_arm/state` 锚定当前位作 hold bias（读不到即 fail-fast
# 退非 0），故硬依赖 S0 而非 Wants。
#
# sd_notify（段(8)）：全部 worker 就绪后 READY=1 + liveness-gated watchdog
# （observer = tick loop / heartbeat pub / 4 rr server / state cache，各自
# loop_tick_count 空闲亦推进）；shutdown 先 STOPPING=1 再停 ping。

[Unit]
Description=XLeRobot S1 coordinator (left arm)
Documentation=file:///home/loosqk/repo/robot/robot-system/scripts/systemd/README_dimos_replace.md

Requires=xlerobot-s0-left-arm.service
After=xlerobot-s0-left-arm.service

StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main

User=loosqk
Group=loosqk
WorkingDirectory=/home/loosqk/repo/robot/robot-system

ExecStart=/home/loosqk/repo/robot/robot-system/target/release/s1_daemon \
    --robot-id xlerobot_left \
    --hardware-id left_arm \
    --config /etc/robot/xlerobot_left_arm.toml

# **生产值 = 5s**（Spec D12 拍板 `Type=notify` + `WatchdogSec=5s`；PX-16
# 明确区分"测试模板 2s / 生产 5s"）。daemon 侧 ping 周期恒 =
# systemd 注入的 WATCHDOG_USEC / 2 = 2.5s，无硬编码。
WatchdogSec=5s
Restart=on-failure
RestartSec=2s

StandardOutput=journal
StandardError=journal
Environment=ROBOT_LOG_FORMAT=json
Environment=RUST_LOG=info,robot=debug

NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

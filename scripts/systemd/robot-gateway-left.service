# XLeRobot RPC gateway —— left 臂（v0.5 候选 E；Spec D12 + D2 身份表）。
#
# 依赖图（r5 V4 锁定）：
# - `Requires=` + `After=` **同臂 S0**：state 池 + estop 链的硬依赖；
# - `Wants=` + `After=` **同臂 S1**：只 `After=` 不会拉起 S1（直启 gateway
#   会 READY 但 task RPC 无后端）；用 `Wants=` 自动拉起，且 **S1 重启不连带
#   停 gateway**。
#
# sd_notify（段(8)）：worker ready → bind → tonic serve → **loopback 自探针
# 首成** → READY=1 → watchdog enforce。探针走
# `/robot.control.v1.RobotControl/GetState` 空 hardware_id → InvalidArgument
# 即算成功（不依赖 S0/S1/cache 首帧，S1 重启不拖垮 gateway 的喂狗）。

[Unit]
Description=XLeRobot RPC gateway (left arm, 127.0.0.1:50051)
Documentation=file:///home/loosqk/repo/robot/robot-system/scripts/systemd/README.md

Requires=robot-s0-left-arm.service
After=robot-s0-left-arm.service
Wants=robot-s1-left.service
After=robot-s1-left.service

StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main

User=loosqk
Group=loosqk
WorkingDirectory=/home/loosqk/repo/robot/robot-system

ExecStart=/home/loosqk/repo/robot/robot-system/target/release/robot-gateway \
    --robot-id xlerobot_left \
    --rpc-roles-toml /etc/robot/rpc-roles.toml \
    --config /etc/robot/xlerobot-left-arm.toml \
    --listen-addr 127.0.0.1:50051

# **生产值 = 5s**（Spec D12 拍板 `Type=notify` + `WatchdogSec=5s`；PX-16
# 明确区分"测试模板 2s / 生产 5s"）。daemon 侧 ping 周期恒 =
# systemd 注入的 WATCHDOG_USEC / 2 = 2.5s，无硬编码。
WatchdogSec=5s
Restart=on-failure
RestartSec=2s

StandardOutput=journal
StandardError=journal
Environment=ROBOT_LOG_FORMAT=json
Environment=RUST_LOG=info,robot=debug

NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

# 只读网页模板；无Requires/Wants，不启动网关或硬件服务。
# 安装前仍需冻结产物与核对配置；本模板不加入S0安装器或自启包。
[Unit]
Description=Robot read-only status page
After=network.target robot-gateway-bus1.service robot-gateway-bus2.service

[Service]
Type=simple
User=loosqk
Group=loosqk
WorkingDirectory=/home/loosqk/repo/robot/robot-system
ExecStart=/home/loosqk/repo/robot/robot-system/target/release/robot-status \
    --config /etc/robot/xlerobot-status.toml
Restart=on-failure
RestartSec=2s
Environment=ROBOT_LOG_FORMAT=json
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal
CPUAffinity=0-3
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

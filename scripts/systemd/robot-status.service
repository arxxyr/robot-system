# 只读网页模板；无Requires/Wants，不启动网关或硬件服务。
# 安装前仍需冻结产物与核对配置；本模板不加入S0安装器或自启包。
[Unit]
Description=Robot read-only status page
After=network.target robot-gateway-bus1.service robot-gateway-bus2.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=loosqk
Group=loosqk
StateDirectory=robot-status
StateDirectoryMode=0700
# 开放校准的网页使用本机启动套接字交接所选侧，并通过会话套接字操作单关节。
RuntimeDirectory=robot-joint-calibration
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
WorkingDirectory=/home/loosqk/repo/robot/robot-system
ExecStart=/home/loosqk/repo/robot/robot-system/target/release/robot-status \
    --config /etc/robot/xlerobot-status.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
Environment=ROBOT_LOG_FORMAT=json
Environment=ROBOT_STATUS_URDF_DIR=/home/loosqk/repo/dimensional-applications/assets/xlerobot
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal
CPUAffinity=0-3
# 独立Web进程的初始资源预算；不占用S0通讯核4/5，不修改S0/S1服务。
# CPUQuota是合计半核预算；TasksMax统计OS线程/进程，不是异步任务数。
CPUQuota=50%
MemoryHigh=128M
MemoryMax=256M
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

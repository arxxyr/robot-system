# 左总线 S1：复用 S0 的八关节配置，启动读取当前反馈作为保持锚点。
# 未取得有效锚点时启动失败；启用和解除急停仍由原控制接口独立处理。
[Unit]
Description=Robot S1 coordinator for bus1
Documentation=file:///home/loosqk/repo/robot/robot-system/scripts/systemd/README.md
Requires=robot-s0-bus1.service
After=robot-s0-bus1.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=loosqk
Group=loosqk
WorkingDirectory=/home/loosqk/repo/robot/robot-system
ExecStart=/home/loosqk/repo/robot/robot-system/target/release/robot-s1 \
    --robot-id xlerobot_bus1_full \
    --hardware-id left_arm_full_with_head \
    --config /home/loosqk/repo/robot/robot-system/configs/xlerobot-bus1.toml
WatchdogSec=5s
# 异常退出后由人工确认断扭并恢复，不在已使能状态自动重建命令发布者。
Restart=no
CPUAffinity=0-3
StandardOutput=journal
StandardError=journal
Environment=ROBOT_LOG_FORMAT=json
Environment=RUST_LOG=info,robot=debug
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

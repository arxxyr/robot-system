# XLeRobot handoff：旧栈退出后，对两条总线的17个电机执行原停止预检。
# （v0.5 候选 E 段(9)；Spec D13 启动拓扑 r5 V1 + r6 W1 + R9-1）。
#
# ## 为什么需要它（单臂直启不得留下另一 bus 的安全空窗）
#
# 旧 coordinator **同时占两条 bus**，启动任一新 arm-only S0 都会经
# `Conflicts=` 停掉**整个旧栈**；而 per-bus preflight 只保本 bus——只启动
# 左臂时 bus2 的 wheels 会长期遗留旧栈状态（旧栈退出只 best-effort 断扭
# 且吞失败）。本 unit 在任何 arm S0 之前对**全部 17 电机**做 ensure-safe：
#
#   bus1 ID 1-8  `Torque_Enable = 0`
#   bus2 ID 1-6  `Torque_Enable = 0`
#   bus2 ID 7-9  先 `Goal_Velocity = 0` 再 `Torque_Enable = 0`
#
# 合计 20 条安全写 + 各自 readback；单项失败继续、末尾聚合 FAIL；一侧串口
# 构造失败**不阻断**另一侧完整执行（R10-3）。
#
# ## 生命周期
#
# `RemainAfterExit=yes`：同一 boot 内第二臂启动时 handoff 已 active，
# **不再重跑**（不碰第一臂已占的串口）。reboot 后自动重新验证（断电后扭矩
# 本就复位，重验无害且 fail-closed）。

[Unit]
Description=XLeRobot handoff transaction (ensure-safe all 17 motors on both buses)
Documentation=file:///home/loosqk/repo/robot/robot-system/scripts/systemd/README_dimos_replace.md

After=network-online.target dev-ttyACM0.device dev-ttyACM1.device
Requires=dev-ttyACM0.device dev-ttyACM1.device

# **旧栈停止顺序的第一责任人**：conflict 目标的 stop job 按 After 排序在本
# unit start 之前完成。升级后的full-bus是本unit的消费者，不列为旧栈。
Conflicts=xlerobot-coordinator.service xlerobot-web.service
After=xlerobot-coordinator.service xlerobot-web.service

[Service]
Type=oneshot
RemainAfterExit=yes

User=loosqk
Group=loosqk
SupplementaryGroups=dialout
WorkingDirectory=/home/loosqk/repo/robot/robot-system

# R10-1：双 config 显式传入，字面写死；与 arm guard 的 --config 及 guard
# 自动追加给 s0_daemon 的 --config 引用**同一绝对路径**。
ExecStart=/home/loosqk/repo/robot/robot-system/target/release/xlerobot_deploy preflight-handoff \
    --left-config /etc/robot/xlerobot_left_arm.toml \
    --right-config /etc/robot/xlerobot_right_arm.toml

# **TimeoutStartSec=infinity 是硬要求，不是保守取值**（round 1 P0-2）：
# D13 明确"给 preflight 定义可证明总时限"这一备选**未采**——任何有限值都
# 可能在"部分电机已写、其余尚未处理"时把进程杀掉，破坏"全部电机继续处理、
# 末尾聚合"的 fail-closed 语义，留下一条半安全的 bus 且无聚合报告。
# preflight 最坏 ~12 s/bus（Feetech 单包 1 s 超时 × ~12 次串口操作），本身
# 有界；真卡死由人工介入，不由 systemd 中途截断。
TimeoutStartSec=infinity

StandardOutput=journal
StandardError=journal
Environment=ROBOT_LOG_FORMAT=json
Environment=RUST_LOG=info,robot=debug

NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

# XLeRobot 全总线候选：原guard预检后exec默认S0，不自动启用。
# 显式沿用本侧已验保护目录，不迁移或复制安全状态。
# 安装前冻结产物/配置；启动前仍须当轮现场确认，见README.md。

[Unit]
AssertPathExists=!/var/lib/robot-joint-calibration/bus1.pending.json
Description=XLeRobot S0 daemon (bus1 full, guard-wrapped)
Documentation=file:///home/loosqk/repo/robot/robot-system/scripts/systemd/README.md
After=network-online.target dev-ttyACM0.device
Requires=dev-ttyACM0.device
Requires=robot-s0-preflight.service
After=robot-s0-preflight.service
Conflicts=xlerobot-coordinator.service xlerobot-web.service robot-s0-left-arm.service robot-s0-right-arm.service xlerobot-s0-left-arm.service xlerobot-s0-right-arm.service xlerobot-s0-bus1.service xlerobot-s0-bus2.service
After=xlerobot-coordinator.service xlerobot-web.service robot-s0-left-arm.service robot-s0-right-arm.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=loosqk
Group=loosqk
SupplementaryGroups=dialout
WorkingDirectory=/home/loosqk/repo/robot/robot-system
RuntimeDirectory=robot-system/preflight
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# 这里只提供权限；实际执行线程CPU/FIFO优先级唯一取自总线TOML。
# 99是允许的优先级上限，不是线程实际优先级。
LimitRTPRIO=99
LimitMEMLOCK=infinity
CPUAffinity=0-3

ExecStart=/home/loosqk/repo/robot/robot-system/target/release/robot-deploy guard \
    --arm left \
    --config /home/loosqk/repo/robot/robot-system/configs/xlerobot-bus1.toml \
    --s0-bin /home/loosqk/repo/robot/robot-system/target/release/robot-s0 \
    --robot-id xlerobot_bus1_full \
    -- \
    --robot-id xlerobot_bus1_full \
    --hardware-id left_arm_full_with_head \
    --latch-path /var/lib/robot/xlerobot_left/estop_latch \
    --rx-trust-dir /var/lib/robot/xlerobot_left \
    --resume-rx-on-clean-exit \
    --tick-hz 50 \
    --notify-mode required

# 预检仍执行原完整聚合；不在部分安全写完成时截断。
TimeoutStartSec=infinity
WatchdogSec=2s
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=86 87 89
ReadWritePaths=/var/lib/robot/xlerobot_left
StandardOutput=journal
StandardError=journal
Environment=ROBOT_LOG_FORMAT=json
Environment=RUST_LOG=info,robot=debug

# 普通线程留在0-3；串口执行线程按TOML严格设置绑核、FIFO及锁页。
# iceoryx2需要共享宿主IPC路径，不启用PrivateTmp。
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

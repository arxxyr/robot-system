# XLeRobot 全总线候选：原guard预检后exec默认S0，不自动启用。
# 显式沿用本侧已验保护目录，不迁移或复制安全状态。
# 安装前冻结产物/配置；启动前仍须当轮现场确认，见README.md。

[Unit]
Description=XLeRobot S0 daemon (bus2 full, guard-wrapped)
Documentation=file:///home/loosqk/repo/robot/robot-system/scripts/systemd/README.md
After=network-online.target dev-ttyACM1.device
Requires=dev-ttyACM1.device
Requires=robot-s0-preflight.service
After=robot-s0-preflight.service
Conflicts=xlerobot-coordinator.service xlerobot-web.service robot-s0-left-arm.service robot-s0-right-arm.service xlerobot-s0-left-arm.service xlerobot-s0-right-arm.service xlerobot-s0-bus1.service xlerobot-s0-bus2.service
After=xlerobot-coordinator.service xlerobot-web.service robot-s0-left-arm.service robot-s0-right-arm.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=loosqk
Group=loosqk
SupplementaryGroups=dialout
WorkingDirectory=/home/loosqk/repo/robot/robot-system
RuntimeDirectory=robot-system/preflight
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

ExecStart=/home/loosqk/repo/robot/robot-system/target/release/robot-deploy guard \
    --arm right \
    --config /home/loosqk/repo/robot/robot-system/configs/xlerobot-bus2.toml \
    --s0-bin /home/loosqk/repo/robot/robot-system/target/release/robot-s0 \
    --robot-id xlerobot_bus2_full \
    -- \
    --robot-id xlerobot_bus2_full \
    --hardware-id right_arm_full_with_base \
    --latch-path /var/lib/robot/xlerobot_right/estop_latch \
    --rx-trust-dir /var/lib/robot/xlerobot_right \
    --tick-hz 50 \
    --notify-mode required

# 预检仍执行原完整聚合；不在部分安全写完成时截断。
TimeoutStartSec=infinity
WatchdogSec=2s
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=86 87 89
ReadWritePaths=/var/lib/robot/xlerobot_right
StandardOutput=journal
StandardError=journal
Environment=ROBOT_LOG_FORMAT=json
Environment=RUST_LOG=info,robot=debug

# 与已验默认S0保持相同调度；本轮不另加RT调度参数。
# iceoryx2需要共享宿主IPC路径，不启用PrivateTmp。
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

# XLeRobot S0 freeze hook systemd e2e 测试 unit 模板（v0.3 A2-3）。
#
# **本文件不要直接 `systemctl --user start`**：它是
# `crates/robot-tests/src/bin/freeze_systemd_smoke.rs` 渲染时用的占位符模板，
# smoke 每 iteration 把占位符替换成真实路径后写到
# `$XDG_RUNTIME_DIR/systemd/user/<unit_name>.service`，再 `systemctl --user
# daemon-reload + start <unit_name>`。占位符表见本文件末尾"占位符"注释。
#
# ## 跟生产 unit 的关系（reviewer A2-3 拍板硬边界）
#
# 跟 `xlerobot-s0-bus1.service` / `xlerobot-s0-bus2.service` 比，本模板**不
# 应**有以下任何一条（**user service 兼容**）：
#
# - `User=` / `Group=` / `SupplementaryGroups=`：user manager 已经按调用方
#   uid 跑，再写 User= 会 conflict。
# - `Requires=dev-ttyACM*.device`：smoke 走 mock_hard_rt adapter，**不依赖
#   真硬件**；TTY 占用 + 物理 enumerate 不参与本测试。
# - `ReadWritePaths=/var/lib/...`：smoke workdir 在 `<workdir-base>/<iter>/`
#   下 user 自有路径，不写 system path。
# - `Conflicts=xlerobot-coordinator.service`：user unit 跟 system unit 不打架。
#
# 保留：
# - `Type=notify` + `NotifyAccess=main`：让 systemd 等 daemon 调 sd_notify(READY=1)。
# - `WatchdogSec=2s`：本测试的核心 —— 测试驱动 freeze ipc_thread → daemon
#   liveness-gated watchdog 不喂 sd_notify(WATCHDOG=1) → systemd 超时重启。
# - `Restart=on-failure` + `RestartSec=2s`：watchdog timeout → SIGABRT →
#   on-failure 拉起新 daemon（PID 切换是 §6.7 #2 真锁定的核心断言）。
# - `StartLimitIntervalSec=60s` + `StartLimitBurst=5`：防 freeze 期间反复
#   重启失控；smoke 5 round 各跑各的 unit_name，本 unit 周期内最多 1-2 次
#   restart，远低于 5 次上限。
#
# ## 占位符（smoke binary 在渲染时替换）
#
# - `@ROBOT_ID@`         smoke 每 iteration 唯一（`<prefix>_<pid>_<iter>`）
# - `@WORKDIR@`          smoke 每 iteration 工作目录（`<workdir-base>/<iter>/`）
# - `@DAEMON_BIN@`       预编译的 `target/.../s0_daemon`（必须带
#                        `--features test-freeze-hook` 编译，否则 control thread
#                        不存在）
# - `@CONFIG_PATH@`      smoke 每 iteration 在 workdir 内生成的 minimal mock
#                        config TOML（`mock_hard_rt` + 1-3 joint，**不**用
#                        `xlerobot_bus2_full.toml` —— 避免依赖 Feetech 真硬件）
# - `@LATCH_PATH@`       smoke 每 iteration 在 workdir 内 provision 的 latch
#                        primary 文件（值 = `0\n`，daemon strict 守门 OK）
# - `@HARDWARE_ID@`      smoke 配置里 `[[hardware]]` 段的 id（默认 `mock_arm`）
# - `@TICK_HZ@`          rt_thread / serial_io_thread tick 频率（默认 `50`）
#
# ## 不在本 unit 范围内的事
#
# - `mock_s1`：本 smoke 不需要 S1 heartbeat。s0_daemon 启动期会自动发一次
#   Event::Enable，state 从 Safe → Ready；不收 S1 heartbeat 时 state 留在
#   Ready（不会推进到 Enabled.Active）。smoke 跑 freeze ipc_thread + 验
#   `state":"Ready"` 出现 ≥ 1 次（main loop heartbeat），加不加 S1 都不
#   改 watchdog 逻辑 + 不改 smoke 4 条硬断言。
# - `--strict-rt`：smoke 不验证 RT 优先级 / mlockall；test-only daemon 走
#   普通优先级（CAP_SYS_NICE 也不一定有）。
# - 真实 `/var/lib/robot/` 路径：所有 path 都在 `@WORKDIR@` 下，每 iteration
#   独立，避免串轮污染。

[Unit]
Description=XLeRobot S0 freeze hook systemd e2e test (@ROBOT_ID@)
Documentation=file://@WORKDIR@/../../../docs/handoffs/v0.3_entry.md

# **不**挂 dev-ttyACM*.device / network-online.target：smoke 用 mock 不依赖
# 物理设备，user manager 也不该 block 在 system target 上。

# 防失控重启：60s 内挂 ≥ 5 次就停止 retry。smoke 单 iteration 周期内通常
# 1-2 次 restart（freeze → systemd 重启 → 新 daemon 跑稳态）。
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
# `Type=notify` 让 systemd 等 daemon 调 sd_notify(READY=1) 才认为 active；
# 详 crates/robot-s0/src/systemd_notify.rs。
Type=notify
NotifyAccess=main

WorkingDirectory=@WORKDIR@

# `--allow-empty-latch` 不传：smoke 已经 provision latch=0\n 走 strict
# 路径（reviewer round 4 阻断 2 实施 §6.7 #3 一致）。
ExecStart=@DAEMON_BIN@ \
    --robot-id @ROBOT_ID@ \
    --hardware-id @HARDWARE_ID@ \
    --config @CONFIG_PATH@ \
    --latch-path @LATCH_PATH@ \
    --tick-hz @TICK_HZ@

# Watchdog 2s：daemon 内按 WATCHDOG_USEC/2 = 1s 周期 ping。freeze ipc_thread
# 5s → 第 1 次 1s ping 走 grace（首周期固定喂 1 次），第 2 次 2s 时
# LivenessObserver 看到 ipc_tick_count 停滞 → 不喂 → systemd 在
# WatchdogSec=2s 处发 SIGABRT。
WatchdogSec=2s

# Restart=on-failure：watchdog timeout / SIGABRT 都触发；clean exit (0) 不
# 触发（smoke 主动 stop 时不会被无限重启）。
Restart=on-failure
RestartSec=2s

# 日志走 journald；smoke 用 `journalctl --user -u <unit>` 抓 PID 切换 +
# `withholding sd_notify(WATCHDOG=1)` 字串 + 两次 `state=Ready` 等。
StandardOutput=journal
StandardError=journal

# JSON 格式让结构化字段（如 ipc_tick_count / state）在 journalctl 输出里
# 易 grep；注意 user-only smoke 不需要 vector / fluentbit 转发，本设置只
# 影响断言可观察性。
Environment=ROBOT_LOG_FORMAT=json
Environment=NO_COLOR=1
Environment=RUST_LOG=info,robot=debug

# 安全收紧：**user services 不能 drop capabilities**（实测
# `RestrictRealtime=yes` / `RestrictNamespaces=yes` / `SystemCallArchitectures=`
# / `LockPersonality=yes` / `ProtectKernel*=` 在 user manager 下都会触发
# `Failed to drop capabilities: Operation not permitted` →
# `status=218/CAPABILITIES`）。生产 unit 跑在 system manager (PID 1) 有
# CAP_SYS_ADMIN 可以 drop，user manager 没有。本模板只保留 user-mode 安全的
# `NoNewPrivileges=yes`，其它安全收紧由生产 system unit 兜底。
NoNewPrivileges=yes

# **不**加 [Install] 节：smoke 不 enable / 不 boot start，只 start。
# 避免 user manager 把 unit 写进 default.target.wants/。

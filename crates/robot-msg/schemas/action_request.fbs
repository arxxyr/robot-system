// action_request.fbs — v0.3 B4 task control plane wire format
// （`InvokeTask` RPC 跨进程 body）。
//
// 对应 docs/00_design.md §5.3 `InvokeTask` frozen RPC + 本仓库
// `crates/robot-rpc/proto/robot_control.proto::InvokeTaskCommand`
// 跨网络 wire 平行版本（详 action_status.fbs 顶部双层 schema 分工
// 解释）。
//
// ### 跨进程通道（B4 outline §4 / §5.4 拍板）
//
// 走 iceoryx2 RequestResponse messaging pattern。RPC 端
// （robot-rpc gateway）做 client，daemon 端
// （robot-s1_daemon::s1_rr_server_thread，B4 (1/3-b) 加）做 server。
// service name `/<robot_id>/control/task_invoke`。
//
// ### 引用关系
//
// 复用 action_status.fbs 里的 `RpcRole`（参考 clear_estop.fbs）+
// `ActionRpcStatus` enum（gateway → s1 → gateway 调用栈一致使用同一
// 套 status code）。
include "clear_estop.fbs";
include "action_status.fbs";

namespace robot.msg;

// ============================================================================
// ActionKindFb
// ============================================================================

// `ActionKind` 的 fbs 形态（对齐 lib `robot_s1::action::ActionKind` +
// proto `ActionKindProto`）。
//
// **v0.4 候选 1 land 后 3 个 variant**（见
// `crates/robot-s1/src/action.rs::ActionKind`）：DwellMs / HoldPose /
// Scripted；**不**放 Stop（混淆 task cancel / S1 degraded / S0 control-lost
// stop / EStop 4 个语义层）。B3+ 落地新 backend 时 lib + proto + fbs
// 三处 variant **同步扩**，不允许只动一处。
enum ActionKindFb : ubyte {
    Unknown = 0,
    DwellMs = 1,
    HoldPose = 2,
    Scripted = 3,
}

// ============================================================================
// InvokeTaskRequest
// ============================================================================

// `InvokeTaskRequest` —— gateway → s1 RR call body for `InvokeTask` RPC.
//
// gateway 端流程（B4 (2/3) 落地）：
//   1. 接 tonic `InvokeTaskCommand`（proto）；
//   2. auth / role / capability / idempotency 校验通过；
//   3. 构造 `InvokeTaskRequest` fbs body（本 table）+ `FrameHeader`
//      envelope；
//   4. iceoryx2 RR client.send → s1 端
//      `s1_rr_server_thread`（B4 (1/3-b) 加）→ coordinator.submit。
//
// ### 字段语义
//
// - `request_id`：proto `CommandMeta.request_id`（UUIDv7 hex），
//   **同时也是** `ActionId`（design §5.2 + B2 outline §2.1 锁
//   定：gateway 端把 `request_id` 直接当 `ActionId`，无需翻译）。
// - `idempotency_key`：design §5.2 CommandMeta.idempotency_key。
//   gateway in-process TTL cache 去重；s1 端**不**做 idempotency
//   check，仅 audit。
// - `source` / `role` / `audit_reason`：仅 audit。
// - `kind`：路由用；s1 端 coordinator 按 (kind, payload_schema_id)
//   找 backend（[`ActionBackend::supported_kinds`]）。
// - `deadline_ns`：CLOCK_MONOTONIC_RAW 截止时刻（gateway 转 RPC
//   `timeout_ms` 为 `now_ns + timeout_ms * 1e6`）。
// - `priority`：B2 单 action 序列化下保留**不**参与决策；B3+
//   scheduler 用（`u32` 比 lib `u8` 宽，避免 wire 升级时阻断；s1
//   端 down-cast 到 lib 类型时溢出拒 `InvalidArgument`）。
// - `payload_schema_id`：路由二级 key；backend 注册时声明
//   [`ActionBackend::supported_schemas`]，dispatcher 按
//   `(kind, schema_id)` 精确匹配。`NO_PAYLOAD_SCHEMA_ID` (= 0) 表
//   示"本请求无 payload"，s1 端 [`ActionRequest::validate`] 强制
//   此时 `payload` 为空（B2 mock backend / DwellMs / HoldPose 走
//   这条路径；`HoldPoseBackend` B3 land）。
// - `payload`：FlatBuffers body bytes（按 `payload_schema_id`）。
//   B3 期间 HoldPose / MockDwell 都用空 payload（配
//   `NO_PAYLOAD_SCHEMA_ID`）；B4 不引入新 payload schema。
// - `stamp_ns`：gateway 端构造 request 时本机 wall-clock ns。仅 audit。
table InvokeTaskRequest {
    request_id:        string;
    idempotency_key:   string;
    source:            string;
    role:              RpcRole = Unknown;
    audit_reason:      string;
    kind:              ActionKindFb = Unknown;
    deadline_ns:       ulong;
    priority:          uint;
    payload_schema_id: uint;
    payload:           [ubyte];
    stamp_ns:          ulong;
}

// ============================================================================
// InvokeTaskResponse
// ============================================================================

// `InvokeTaskResponse` —— s1 → gateway RR reply body.
//
// 字段语义：
// - `request_id`：回填 request.request_id，gateway 端用以 correlate。
// - `status`：处理结果。
//     - `Ok` = `Coordinator::submit` 返 `Ok(ActionTicket)`；s1 端
//       同时已注册 events drain pubsub topic（B4 (1/3-c) 落地），
//       gateway 端拿到此 reply 后才能开 `StreamTaskEvents`。
//     - `InvalidArgument` = `SubmitError::InvalidRequest` /
//       `UnsupportedSchema`
//     - `FailedPrecondition` = `NotReady` / `CoordinatorDegraded` /
//       `BackendStartFailed::{Rejected,PayloadDecode,HardwareMismatch}`
//     - `AlreadyExists` = `BusyExecuting`
//     - `Unimplemented` = `NoBackendForKind`
//     - `Unavailable` = `ShuttingDown`
//     - `Internal` = `BackendStartFailed` 兜底（B3 期间无路径）
// - `error_msg`：status != Ok 时人类可读错误描述（max ~256 chars）；
//   Ok 时填空串。
// - `action_id`：UUIDv7 hex（= request.request_id；echo 回填给
//   gateway 用以构造 proto `TaskHandle`）。status != Ok 时填空串。
// - `accepted_at_ns`：status == Ok 时填 daemon 内 `clock.now()`
//   （Coordinator 接受 submit 转入 EXECUTING 的时刻）；status != Ok
//   时填 0。
table InvokeTaskResponse {
    request_id:     string;
    status:         ActionRpcStatus = Unknown;
    error_msg:      string;
    action_id:      string;
    accepted_at_ns: ulong;
}

// 本文件两个 table 都是 root 候选，按 schema_id 路由。flatc 需要一
// 个顶层 root_type 声明；选 `InvokeTaskRequest` 作占位，不影响
// `InvokeTaskResponse` 的 root 解析。
root_type InvokeTaskRequest;

# Rust 构建产物
/target
**/*.rs.bk
*.pdb

# Cargo 锁文件策略：
# 本项目最终会发布 S0/S1 二进制，Cargo.lock 需要进版本控制以保证可复现构建。
# 如有子 workspace / subcrate 额外生成 Cargo.lock，按需精细化忽略。
# （默认不忽略 Cargo.lock）

# sccache 缓存
*.sccache*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~.nib

# 环境 / 机密
.env
.env.*
!.env.example

# Python 工具链（robot-s2-bridge / robot-policy-host 未来可能产生）
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# FlatBuffers 生成文件 —— Step 2 起由 build.rs 输出到 OUT_DIR，
# 不应被 check-in。保险起见忽略 *.fbs 对应的顶层 generated/ 目录。
/generated/

# 录制产物（开发期调试产生的 .mcap / .robotrec）
/recordings/
*.mcap
*.robotrec

# perf record 产出（GB 级，跑 flamegraph 时本地生成；SVG 入 docs/perf/，
# 原始 perf.data 不进版本控制）
perf*.data
perf*.data.old

# 测试 / smoke 运行期生成的 workdir（latch / config / iter 临时文件）
# 比如 freeze_systemd_smoke 在 logs/freeze_smoke/<iter>/ 写 latch + cfg
# + crash_restart_smoke 在 logs/crash_test/ 写 latch
/logs

.claude/*

# 用户要求移除的历史大体积验收包，避免再次进入提交历史。
/.verify/post_e_comm_fault_hardening/H_evidence.tar.gz

# 已清理的旧会话、重复源码载荷及原封装；保留日志和精简包。
/claude-session-backup-20260731.tar.gz
/.verify/xlerobot_sync_zero_2026-10-13_software/native/source-inputs-root597-sync-zero.tar.gz
/.verify/xlerobot_sync_zero_2026-10-13_software/native/originals/boot/source-inputs-root597.tar.gz
/.verify/xlerobot_sync_zero_2026-10-13_software/native/single_ssh_native_sync_zero_software_r1.sh
/.verify/xlerobot_sync_zero_2026-10-13_software/native/native-originals-sync-zero-software-r1.tar.gz
/.verify/xlerobot_sync_zero_2026-10-13_software/native/tools/xlerobot-sync-zero-native-software-20261013-r1.owner/child.log
/.verify/h2_trace_owner_2026-09-30/evidence.tar.gz
/.verify/robot_viz_2026-09-29/evidence.tar.gz
